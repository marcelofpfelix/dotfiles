#!/usr/bin/env bash
set -euo pipefail

app_bin="${ONEPASSWORD_BIN:-/usr/bin/1password}"
if [ ! -x "$app_bin" ]; then
  app_bin="$(command -v 1password)"
fi

# Keep Electron apps out of inherited Nix/Mesa loader state from Hyprland.
unset __EGL_VENDOR_LIBRARY_FILENAMES
unset LD_LIBRARY_PATH
unset LIBGL_DRIVERS_PATH
unset LIBVA_DRIVERS_PATH
unset GBM_BACKENDS_PATH
unset VDPAU_DRIVER_PATH
unset VK_ICD_FILENAMES
unset VK_LAYER_PATH
unset __GLX_VENDOR_LIBRARY_NAME
unset QT_QUICK_BACKEND

runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
browser_socket="$runtime_dir/1Password-BrowserSupport.sock"
if [ -S "$browser_socket" ] \
  && ! pgrep -u "$(id -u)" -f "^${app_bin}( |$)" >/dev/null 2>&1; then
  rm -f "$browser_socket"
fi

# 1Password 8.12 crashes in its bundled Electron Wayland/Vulkan path.
exec "$app_bin" --ozone-platform=wayland --disable-gpu "$@"
