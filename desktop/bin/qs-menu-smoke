#!/usr/bin/env bash
set -uo pipefail

export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:$PATH"

sleep_time="${QS_MENU_SMOKE_SLEEP:-0.5}"
base_dir="${QS_MENU_SMOKE_BASE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/quickshell/menu-smoke}"
out_dir="${QS_MENU_SMOKE_DIR:-$base_dir/$(date +%Y%m%d-%H%M%S)}"
latest_link="${QS_MENU_SMOKE_LATEST:-$base_dir/latest}"
summary_file="$out_dir/summary.tsv"
contact_sheet="$out_dir/contact.png"
thumbnail_size="${QS_MENU_SMOKE_THUMBNAIL:-760x428}"
previous_dir="${QS_MENU_SMOKE_PREVIOUS_DIR:-}"
min_width="${QS_MENU_SMOKE_MIN_WIDTH:-320}"
min_height="${QS_MENU_SMOKE_MIN_HEIGHT:-180}"
min_changed_pixels="${QS_MENU_SMOKE_MIN_CHANGED_PIXELS:-5000}"
panels=(launcher launcher-script controls media notifications calendar wallpaper screen settings keybindings clipboard websearch network tray power power-confirm)
status=0
open_after=0
inspect_after=0

usage() {
  printf 'use: qs-menu-smoke [--open] [--inspect] [--list|panel ...]\n' >&2
  printf 'captures: %s\n' "${panels[*]}" >&2
}

record_result() {
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "${3:--}" "${4:--}" "${5:--}" >>"$summary_file"
}

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing: %s\n' "$1" >&2
    status=1
    return 1
  fi
}

assert_capture() {
  local panel=$1 file=$2 baseline=$3 width height stddev changed

  if ! read -r width height stddev < <(identify -format "%w %h %[standard-deviation]\n" "$file" 2>/dev/null); then
    printf "fail %s image metadata\n" "$panel" >&2
    record_result "$panel" fail metadata "$file" "$baseline"
    status=1
    return 1
  fi

  if (( width < min_width || height < min_height )); then
    printf "fail %s image too small: %sx%s\n" "$panel" "$width" "$height" >&2
    record_result "$panel" fail "small:${width}x${height}" "$file" "$baseline"
    status=1
    return 1
  fi

  case "$stddev" in
    ""|0|0.0*)
      printf "fail %s image blank: stddev=%s\n" "$panel" "$stddev" >&2
      record_result "$panel" fail "blank:$stddev" "$file" "$baseline"
      status=1
      return 1
      ;;
  esac

  changed=$(compare -metric AE "$baseline" "$file" null: 2>&1 >/dev/null || true)
  changed=${changed%% *}
  if ! awk -v value="$changed" -v min="$min_changed_pixels" 'BEGIN { exit !(value + 0 >= min) }'; then
    printf "fail %s no visible panel change: changed=%s min=%s\n" "$panel" "$changed" "$min_changed_pixels" >&2
    record_result "$panel" fail "changed:$changed" "$file" "$baseline"
    status=1
    return 1
  fi
}

crop_focused_monitor() {
  local panel=$1 file=$2 crop=$3 geometry

  command -v hyprctl >/dev/null 2>&1 || return 1
  command -v jq >/dev/null 2>&1 || return 1
  command -v convert >/dev/null 2>&1 || return 1
  geometry=$(hyprctl monitors -j 2>/dev/null | jq -r '.[] | select(.focused) | "\(.width)x\(.height)+\(.x)+\(.y)"' | sed -n '1p')
  [[ "$geometry" =~ ^[0-9]+x[0-9]+[+-][0-9]+[+-][0-9]+$ ]] || return 1
  convert "$file" -crop "$geometry" +repage "$crop" >/dev/null 2>&1 || return 1
  printf "crop-monitor %s %s\n" "$panel" "$crop"
}

capture_panel() {
  local panel=$1 file baseline crop
  local -a open_cmd
  file="$out_dir/$panel.png"
  baseline="$out_dir/$panel.before.png"
  crop="$out_dir/$panel.crop.png"

  qs-bar close-panels >/dev/null 2>&1 || {
    printf "fail close-panels before %s\n" "$panel" >&2
    status=1
    return
  }
  sleep "$sleep_time"
  if ! grim "$baseline" || [ ! -s "$baseline" ]; then
    printf "fail %s baseline capture\n" "$panel" >&2
    status=1
    return
  fi
  case "$panel" in
    launcher-script) open_cmd=(qs-launcher open) ;;
    *) open_cmd=(qs-bar "$panel") ;;
  esac
  if ! "${open_cmd[@]}" >/dev/null 2>&1; then
    printf 'fail %s open\n' "$panel" >&2
    status=1
    return
  fi
  sleep "$sleep_time"
  if grim "$file" && [ -s "$file" ] && assert_capture "$panel" "$file" "$baseline"; then
    read -r width height _ < <(identify -format "%w %h %[standard-deviation]\n" "$file" 2>/dev/null || printf -- '- - -\n')
    changed=$(compare -metric AE "$baseline" "$file" null: 2>&1 >/dev/null || true)
    changed=${changed%% *}
    crop_focused_monitor "$panel" "$file" "$crop" || true
    record_result "$panel" ok "${width}x${height}:changed=$changed" "$file" "$baseline"
    printf 'ok   %s %s\n' "$panel" "$file"
  else
    printf 'fail %s capture\n' "$panel" >&2
    status=1
  fi
  qs-bar close-panels >/dev/null 2>&1 || {
    printf "fail close-panels after %s\n" "$panel" >&2
    status=1
  }
}

write_contact_sheet() {
  local files=() panel

  command -v montage >/dev/null 2>&1 || return 0
  for panel in "${panels[@]}"; do
    if [ -s "$out_dir/$panel.crop.png" ]; then
      files+=("$out_dir/$panel.crop.png")
    elif [ -s "$out_dir/$panel.png" ]; then
      files+=("$out_dir/$panel.png")
    fi
  done
  [ "${#files[@]}" -gt 0 ] || return 0
  montage "${files[@]}" -thumbnail "$thumbnail_size" -label "%t" -background "#202020" -fill white -geometry +12+28 "$contact_sheet" >/dev/null 2>&1 || return 0
  printf "contact %s\n" "$contact_sheet"
}

inspect_contact_sheet() {
  local prompt
  local -a images

  [ -s "$contact_sheet" ] || return 0
  command -v codex >/dev/null 2>&1 || {
    printf 'missing: codex\n' >&2
    status=1
    return 1
  }

  prompt='Inspect these Quickshell menu contact-sheet screenshots visually. The last image is the current run; earlier images are previous context if present. Do not run tools. Report whether you can see the images, then list concrete visible UI problems only: clipping, overlap, bad spacing, inconsistent sizing, unreadable text, huge empty areas, and regressions versus prior images. Keep it concise.'
  if [ -n "$previous_dir" ] && [ -s "$previous_dir/contact.png" ] && [ "$previous_dir/contact.png" != "$contact_sheet" ]; then
    images+=(--image "$previous_dir/contact.png")
  fi
  images+=(--image "$contact_sheet")

  printf '%s\n' "$prompt" | codex exec --ephemeral --sandbox read-only --cd "$PWD" "${images[@]}" -
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --open) open_after=1; shift ;;
    --inspect) inspect_after=1; shift ;;
    --) shift; break ;;
    --list|-h|--help) break ;;
    --*) usage; exit 2 ;;
    *) break ;;
  esac
done

case "${1:-}" in
  --list) printf '%s\n' "${panels[@]}"; exit 0 ;;
  -h|--help) usage; exit 0 ;;
esac

need qs-bar
need grim
need identify
need compare
[ "$status" -eq 0 ] || exit "$status"

if [ -z "$previous_dir" ]; then
  previous_dir="$(readlink -f "$latest_link" 2>/dev/null || true)"
fi
mkdir -p "$out_dir"
printf 'panel\tstatus\tdetail\tfile\tbaseline\n' >"$summary_file"
ln -sfn "$out_dir" "$latest_link" 2>/dev/null || true
trap 'qs-bar close-panels >/dev/null 2>&1 || true' EXIT

if [ "$#" -gt 0 ]; then
  panels=("$@")
fi

for panel in "${panels[@]}"; do
  capture_panel "$panel"
done

printf 'dir  %s\n' "$out_dir"
printf 'latest %s\n' "$latest_link"
write_contact_sheet
if [ "$open_after" -eq 1 ] && [ -s "$contact_sheet" ]; then
  xdg-open "$contact_sheet" >/dev/null 2>&1 &
fi
if [ "$inspect_after" -eq 1 ]; then
  inspect_contact_sheet || true
fi
printf 'summary %s\n' "$summary_file"
exit "$status"
