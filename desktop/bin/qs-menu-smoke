#!/usr/bin/env bash
set -uo pipefail

export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:$PATH"

sleep_time="${QS_MENU_SMOKE_SLEEP:-0.5}"
base_dir="${QS_MENU_SMOKE_BASE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/quickshell/menu-smoke}"
out_dir="${QS_MENU_SMOKE_DIR:-$base_dir/$(date +%Y%m%d-%H%M%S)}"
latest_link="${QS_MENU_SMOKE_LATEST:-$base_dir/latest}"
summary_file="$out_dir/summary.tsv"
contact_sheet="$out_dir/contact.png"
min_width="${QS_MENU_SMOKE_MIN_WIDTH:-320}"
min_height="${QS_MENU_SMOKE_MIN_HEIGHT:-180}"
min_changed_pixels="${QS_MENU_SMOKE_MIN_CHANGED_PIXELS:-5000}"
panels=(launcher launcher-script controls media notifications calendar wallpaper screen settings keybindings clipboard websearch network tray power)
status=0

usage() {
  printf 'use: qs-menu-smoke [--list|panel ...]\n' >&2
  printf 'captures: %s\n' "${panels[*]}" >&2
}

record_result() {
  printf '%s\t%s\t%s\t%s\t%s\n' "$1" "$2" "${3:--}" "${4:--}" "${5:--}" >>"$summary_file"
}

need() {
  if ! command -v "$1" >/dev/null 2>&1; then
    printf 'missing: %s\n' "$1" >&2
    status=1
    return 1
  fi
}

assert_capture() {
  local panel=$1 file=$2 baseline=$3 width height stddev changed

  if ! read -r width height stddev < <(identify -format "%w %h %[standard-deviation]\n" "$file" 2>/dev/null); then
    printf "fail %s image metadata\n" "$panel" >&2
    record_result "$panel" fail metadata "$file" "$baseline"
    status=1
    return 1
  fi

  if (( width < min_width || height < min_height )); then
    printf "fail %s image too small: %sx%s\n" "$panel" "$width" "$height" >&2
    record_result "$panel" fail "small:${width}x${height}" "$file" "$baseline"
    status=1
    return 1
  fi

  case "$stddev" in
    ""|0|0.0*)
      printf "fail %s image blank: stddev=%s\n" "$panel" "$stddev" >&2
      record_result "$panel" fail "blank:$stddev" "$file" "$baseline"
      status=1
      return 1
      ;;
  esac

  changed=$(compare -metric AE "$baseline" "$file" null: 2>&1 >/dev/null || true)
  changed=${changed%% *}
  if ! awk -v value="$changed" -v min="$min_changed_pixels" 'BEGIN { exit !(value + 0 >= min) }'; then
    printf "fail %s no visible panel change: changed=%s min=%s\n" "$panel" "$changed" "$min_changed_pixels" >&2
    record_result "$panel" fail "changed:$changed" "$file" "$baseline"
    status=1
    return 1
  fi
}

capture_panel() {
  local panel=$1 file baseline
  local -a open_cmd
  file="$out_dir/$panel.png"
  baseline="$out_dir/$panel.before.png"

  qs-bar close-panels >/dev/null 2>&1 || {
    printf "fail close-panels before %s\n" "$panel" >&2
    status=1
    return
  }
  sleep "$sleep_time"
  if ! grim "$baseline" || [ ! -s "$baseline" ]; then
    printf "fail %s baseline capture\n" "$panel" >&2
    status=1
    return
  fi
  case "$panel" in
    launcher-script) open_cmd=(qs-launcher open) ;;
    *) open_cmd=(qs-bar "$panel") ;;
  esac
  if ! "${open_cmd[@]}" >/dev/null 2>&1; then
    printf 'fail %s open\n' "$panel" >&2
    status=1
    return
  fi
  sleep "$sleep_time"
  if grim "$file" && [ -s "$file" ] && assert_capture "$panel" "$file" "$baseline"; then
    read -r width height _ < <(identify -format "%w %h %[standard-deviation]\n" "$file" 2>/dev/null || printf -- '- - -\n')
    changed=$(compare -metric AE "$baseline" "$file" null: 2>&1 >/dev/null || true)
    changed=${changed%% *}
    record_result "$panel" ok "${width}x${height}:changed=$changed" "$file" "$baseline"
    printf 'ok   %s %s\n' "$panel" "$file"
  else
    printf 'fail %s capture\n' "$panel" >&2
    status=1
  fi
  qs-bar close-panels >/dev/null 2>&1 || {
    printf "fail close-panels after %s\n" "$panel" >&2
    status=1
  }
}

write_contact_sheet() {
  local files=() panel

  command -v montage >/dev/null 2>&1 || return 0
  for panel in "${panels[@]}"; do
    [ -s "$out_dir/$panel.png" ] && files+=("$out_dir/$panel.png")
  done
  [ "${#files[@]}" -gt 0 ] || return 0
  montage "${files[@]}" -thumbnail 420x260 -label "%t" -background "#202020" -fill white -geometry +12+28 "$contact_sheet" >/dev/null 2>&1 || return 0
  printf "contact %s\n" "$contact_sheet"
}

case "${1:-}" in
  --list) printf '%s\n' "${panels[@]}"; exit 0 ;;
  -h|--help) usage; exit 0 ;;
esac

need qs-bar
need grim
need identify
need compare
[ "$status" -eq 0 ] || exit "$status"

mkdir -p "$out_dir"
printf 'panel\tstatus\tdetail\tfile\tbaseline\n' >"$summary_file"
ln -sfn "$out_dir" "$latest_link" 2>/dev/null || true
trap 'qs-bar close-panels >/dev/null 2>&1 || true' EXIT

if [ "$#" -gt 0 ]; then
  panels=("$@")
fi

for panel in "${panels[@]}"; do
  capture_panel "$panel"
done

printf 'dir  %s\n' "$out_dir"
printf 'latest %s\n' "$latest_link"
write_contact_sheet
printf 'summary %s\n' "$summary_file"
exit "$status"
