#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:$PATH"

floating=0
if [ "${1:-}" = "--floating" ]; then
    floating=1
    shift
fi

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Hyprland" "$1"
    else
        printf '%s\n' "$1" >&2
    fi
}


launch() {
    if command -v "$1" >/dev/null 2>&1; then
        nohup hypr-clean-env "$@" >/tmp/hypr-term.log 2>&1 </dev/null &
        exit 0
    fi
}

run_foreground() {
    if command -v "$1" >/dev/null 2>&1; then
        exec hypr-clean-env "$@"
    fi
}

if [ "$floating" -eq 1 ]; then
    if [ $# -gt 0 ]; then
        run_foreground ghostty --title=hypr-floating -e "$@"
        run_foreground /snap/bin/ghostty --title=hypr-floating -e "$@"
        run_foreground wezterm start --always-new-process --class floating -- "$@"
    else
        run_foreground ghostty --title=hypr-floating
        run_foreground /snap/bin/ghostty --title=hypr-floating
        run_foreground wezterm start --always-new-process --class floating
    fi
fi


if [ $# -gt 0 ]; then
    launch ghostty -e "$@"
    launch /snap/bin/ghostty -e "$@"
    launch wezterm start -- "$@"
    launch gnome-terminal -- "$@"
    launch terminator -x "$@"
    launch x-terminal-emulator -e "$@"
else
    launch ghostty
    launch /snap/bin/ghostty
    launch wezterm start
    launch gnome-terminal
    launch terminator
    launch x-terminal-emulator
fi

notify "No terminal emulator found. Install ghostty, gnome-terminal, wezterm, terminator, or x-terminal-emulator."
exit 1
