#!/usr/bin/env bash
set -uo pipefail

export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:$PATH"

status=0

section() {
  printf '\n%s\n' "$1"
}

ok() {
  printf 'ok   %-22s %s\n' "$1" "$2"
}

warn() {
  printf 'warn %-22s %s\n' "$1" "$2"
}

fail() {
  printf 'fail %-22s %s\n' "$1" "$2"
  status=1
}

check_cmd() {
  local name=$1 required=${2:-yes} path
  path=$(command -v "$name" 2>/dev/null || true)
  if [ -n "$path" ]; then
    ok "$name" "$path"
  elif [ "$required" = yes ]; then
    fail "$name" missing
  else
    warn "$name" missing
  fi
}

run_required() {
  local label=$1
  shift
  if "$@"; then
    return 0
  fi
  fail "$label" "command failed: $*"
}

current_profile() {
  local line tab
  tab=$(printf '\t')
  line=$(hypr-keys 2>/dev/null | sed -n '1p' || true)
  case "$line" in
    Profile"$tab"*) ok current-profile "${line#*"$tab"}" ;;
    *) fail current-profile "hypr-keys did not report profile" ;;
  esac
}

check_wayland_wrapper_common() {
  local wrapper=$1 path=$2 flag var

  for var in __EGL_VENDOR_LIBRARY_FILENAMES LD_LIBRARY_PATH LIBGL_DRIVERS_PATH LIBVA_DRIVERS_PATH GBM_BACKENDS_PATH VDPAU_DRIVER_PATH VK_ICD_FILENAMES VK_LAYER_PATH __GLX_VENDOR_LIBRARY_NAME QT_QUICK_BACKEND; do
    if grep -Fq -- "unset $var" "$path" 2>/dev/null; then
      ok "$wrapper" "unsets $var"
    else
      fail "$wrapper" "missing unset $var"
    fi
  done

  for flag in '--ozone-platform=wayland' 'WebRTCPipeWireCapturer'; do
    if grep -Fq -- "$flag" "$path" 2>/dev/null; then
      ok "$wrapper" "$flag"
    else
      fail "$wrapper" "missing $flag"
    fi
  done

  if grep -Eq -- '--use-gl=egl|--use-angle=opengl|--use-gl=angle|--in-process-gpu|--disable-gpu' "$path" 2>/dev/null; then
    fail "$wrapper" "contains GL flags known to break WebGL here"
  else
    ok "$wrapper" "no broken GL override flags"
  fi
}

check_browser_wrapper() {
  local name=$1 wrapper=$2 browser=$3 path browser_path flag
  path=$(command -v "$wrapper" 2>/dev/null || true)
  if [ -z "$path" ]; then
    fail "$wrapper" missing
    return
  fi
  ok "$wrapper" "$path"

  browser_path=$(command -v "$browser" 2>/dev/null || true)
  if [ -n "$browser_path" ]; then
    ok "$name-bin" "$browser_path"
  else
    warn "$name-bin" "missing $browser"
  fi

  check_wayland_wrapper_common "$wrapper" "$path"

  for flag in '--enable-native-notifications' '--disable-vulkan'; do
    if grep -Fq -- "$flag" "$path" 2>/dev/null; then
      ok "$wrapper" "$flag"
    else
      fail "$wrapper" "missing $flag"
    fi
  done
}

check_electron_wrapper() {
  local name=$1 wrapper=$2 app=$3 path app_path
  path=$(command -v "$wrapper" 2>/dev/null || true)
  if [ -z "$path" ]; then
    fail "$wrapper" missing
    return
  fi
  ok "$wrapper" "$path"

  app_path=$(command -v "$app" 2>/dev/null || true)
  if [ -n "$app_path" ]; then
    ok "$name-bin" "$app_path"
  else
    warn "$name-bin" "missing $app"
  fi

  check_wayland_wrapper_common "$wrapper" "$path"
}

check_user_service_active() {
  local service=$1 state
  state=$(systemctl --user is-active "$service" 2>/dev/null || true)
  if [ "$state" = active ]; then
    ok "$service" active
  else
    fail "$service" "${state:-missing}"
  fi
}

check_screen_share() {
  local portal_file portal_env wrapper path

  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    ok wayland-display "$WAYLAND_DISPLAY"
  else
    fail wayland-display missing
  fi

  if [ "${XDG_CURRENT_DESKTOP:-}" = Hyprland ]; then
    ok current-desktop Hyprland
  else
    fail current-desktop "${XDG_CURRENT_DESKTOP:-missing}"
  fi

  if hyprctl monitors -j >/dev/null 2>&1; then
    ok hyprctl-monitors ok
  else
    fail hyprctl-monitors failed
  fi

  check_user_service_active xdg-desktop-portal-hyprland.service
  check_user_service_active xdg-desktop-portal.service

  portal_file="$HOME/.local/share/xdg-desktop-portal/portals/hyprland.portal"
  if [ -r "$portal_file" ] && grep -Fq ScreenCast "$portal_file"; then
    ok hyprland-portal ScreenCast
  else
    fail hyprland-portal "missing ScreenCast in $portal_file"
  fi

  portal_env=$(systemctl --user show xdg-desktop-portal.service -p Environment --value 2>/dev/null || true)
  case "$portal_env" in
    *"$HOME/.local/share"*) ok portal-xdg-data "$HOME/.local/share" ;;
    *) fail portal-xdg-data "missing $HOME/.local/share" ;;
  esac

  for wrapper in chrome-wayland brave-wayland; do
    path=$(command -v "$wrapper" 2>/dev/null || true)
    if [ -n "$path" ] && grep -Fq WebRTCPipeWireCapturer "$path"; then
      ok "$wrapper" WebRTCPipeWireCapturer
    else
      fail "$wrapper" "missing WebRTCPipeWireCapturer"
    fi
  done
}

section "required commands"
for cmd in hypr-session hypr-keys qs-bar qs-menu-smoke identify compare audioctl check-audio-streams cliphist-menu screenshot-wayland wallpaper-wayland screen-record-wayland monitor chrome-wayland brave-wayland desktop-package-audit check-wayland-no-x11 script-picker walker-websearch; do
  check_cmd "$cmd" yes
done
check_cmd walker yes
check_cmd gum yes
check_cmd fzf yes

section "pickers"
run_required script-picker script-picker --status
run_required walker-websearch walker-websearch --status

section "session smoke"
run_required hypr-session hypr-session smoke

section "package intent"
run_required desktop-package-audit desktop-package-audit

section "wayland archive guard"
run_required check-wayland-no-x11 check-wayland-no-x11

section "profile"
current_profile

section "quickshell"
run_required qs-bar qs-bar status

section "audio"
run_required audioctl audioctl status
run_required audioctl-self-test audioctl self-test
if command -v check-audio-streams >/dev/null 2>&1; then
  check-audio-streams || true
fi

section "clipboard"
run_required cliphist-menu cliphist-menu status

section "screenshots"
run_required screenshot-wayland screenshot-wayland status

section "wallpaper"
run_required wallpaper-wayland wallpaper-wayland status

section "screen record"
run_required screen-record-wayland screen-record-wayland status

section "monitors"
run_required monitor monitor status

section "screen share"
check_screen_share

section "browser wrappers"
check_browser_wrapper chrome chrome-wayland google-chrome-stable
check_browser_wrapper brave brave-wayland brave-browser-stable
check_electron_wrapper slack slack-wayland slack
check_electron_wrapper discord discord-wayland discord
check_electron_wrapper obsidian obsidian-wayland obsidian
check_electron_wrapper 1password 1password-wayland 1password

exit "$status"
