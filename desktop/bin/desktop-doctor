#!/usr/bin/env bash
set -uo pipefail

export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:$PATH"

status=0
FIXABLE=false

case "${1:-}" in
  --fixable) FIXABLE=true; shift ;;
  -h|--help) printf 'use: desktop-doctor [--fixable]\n'; exit 0 ;;
esac

if [ "$#" -gt 0 ]; then
  printf 'use: desktop-doctor [--fixable]\n' >&2
  exit 2
fi

section() {
  printf '\n%s\n' "$1"
}

ok() {
  printf 'ok   %-22s %s\n' "$1" "$2"
}

warn() {
  printf 'warn %-22s %s\n' "$1" "$2"
}

fix_hint() {
  local command=${3:-}
  if [ -n "$command" ]; then
    printf 'fix  %-22s %s\n' "$1" "$command"
    return
  fi

  case "$1" in
    hypr-session|hypr-keys|hypr-term|qs-bar|qs-menu-smoke|desktop-reload|desktop-notification-smoke|desktop-inhibit|desktop-accept|desktop-startup-report|audioctl|check-audio-streams|cliphist-menu|screenshot-wayland|wallpaper-wayland|screen-record-wayland|monitor|chrome-wayland|brave-wayland|desktop-package-audit|check-wayland-no-x11|board|script-picker|walker-websearch|slack-wayland|discord-wayland|obsidian-wayland|1password-wayland|desktop-privacy-status|desktop-osd|external-brightness|media-now-playing|notification-focus-app)
      printf 'fix  %-22s home -y\n' "$1"
      ;;
    walker|gum|fzf|identify|compare|montage)
      printf 'fix  %-22s track/install the missing package in homelab, then run home -y\n' "$1"
      ;;
    current-profile)
      printf 'fix  %-22s hypr-session reload\n' "$1"
      ;;
    quickshell)
      printf 'fix  %-22s hypr-session reload\n' "$1"
      ;;
    wayland-display|current-desktop|hyprctl-monitors)
      printf 'fix  %-22s log into the Hyprland Wayland session\n' "$1"
      ;;
    xdg-desktop-portal-hyprland.service|xdg-desktop-portal.service)
      printf 'fix  %-22s systemctl --user restart xdg-desktop-portal-hyprland.service xdg-desktop-portal.service xdg-desktop-portal-gtk.service\n' "$1"
      ;;
    hyprland-portal)
      printf 'fix  %-22s home -y && sudo /home/marcelof/bin/xdph-install-system\n' "$1"
      ;;
    portal-xdg-data)
      printf 'fix  %-22s systemctl --user daemon-reload && systemctl --user restart xdg-desktop-portal.service\n' "$1"
      ;;
  esac
}

fail() {
  printf 'fail %-22s %s\n' "$1" "$2"
  status=1
  if [ "$FIXABLE" = true ]; then
    fix_hint "$1" "$2" "${3:-}"
  fi
}

check_cmd() {
  local name=$1 required=${2:-yes} path
  path=$(command -v "$name" 2>/dev/null || true)
  if [ -n "$path" ]; then
    ok "$name" "$path"
  elif [ "$required" = yes ]; then
    fail "$name" missing
  else
    warn "$name" missing
  fi
}

run_required() {
  local label=$1 command
  shift
  command=$1
  if ! command -v "$command" >/dev/null 2>&1; then
    fail "$label" "missing command: $command" "$*"
    return 1
  fi
  if "$@"; then
    return 0
  fi
  fail "$label" "command failed: $*" "$*"
}

current_profile() {
  local line tab
  tab=$(printf '\t')
  line=$(hypr-keys 2>/dev/null | sed -n '1p' || true)
  case "$line" in
    Profile"$tab"*) ok current-profile "${line#*"$tab"}" ;;
    *) fail current-profile "hypr-keys did not report profile" ;;
  esac
}

check_wayland_wrapper_common() {
  local wrapper=$1 path=$2 flag var

  for var in __EGL_VENDOR_LIBRARY_FILENAMES LD_LIBRARY_PATH LIBGL_DRIVERS_PATH LIBVA_DRIVERS_PATH GBM_BACKENDS_PATH VDPAU_DRIVER_PATH VK_ICD_FILENAMES VK_LAYER_PATH __GLX_VENDOR_LIBRARY_NAME QT_QUICK_BACKEND; do
    if grep -Fq -- "unset $var" "$path" 2>/dev/null; then
      ok "$wrapper" "unsets $var"
    else
      fail "$wrapper" "missing unset $var"
    fi
  done

  for flag in '--ozone-platform=wayland' 'WebRTCPipeWireCapturer'; do
    if grep -Fq -- "$flag" "$path" 2>/dev/null; then
      ok "$wrapper" "$flag"
    else
      fail "$wrapper" "missing $flag"
    fi
  done

  if grep -Eq -- '--use-gl=egl|--use-angle=opengl|--use-gl=angle|--in-process-gpu|--disable-gpu' "$path" 2>/dev/null; then
    fail "$wrapper" "contains GL flags known to break WebGL here"
  else
    ok "$wrapper" "no broken GL override flags"
  fi
}

check_browser_wrapper() {
  local name=$1 wrapper=$2 browser=$3 path browser_path flag
  path=$(command -v "$wrapper" 2>/dev/null || true)
  if [ -z "$path" ]; then
    fail "$wrapper" missing
    return
  fi
  ok "$wrapper" "$path"

  browser_path=$(command -v "$browser" 2>/dev/null || true)
  if [ -n "$browser_path" ]; then
    ok "$name-bin" "$browser_path"
  else
    warn "$name-bin" "missing $browser"
  fi

  check_wayland_wrapper_common "$wrapper" "$path"

  for flag in '--enable-native-notifications' '--disable-vulkan'; do
    if grep -Fq -- "$flag" "$path" 2>/dev/null; then
      ok "$wrapper" "$flag"
    else
      fail "$wrapper" "missing $flag"
    fi
  done
}

check_electron_wrapper() {
  local name=$1 wrapper=$2 app=$3 path app_path
  path=$(command -v "$wrapper" 2>/dev/null || true)
  if [ -z "$path" ]; then
    fail "$wrapper" missing
    return
  fi
  ok "$wrapper" "$path"

  app_path=$(command -v "$app" 2>/dev/null || true)
  if [ -n "$app_path" ]; then
    ok "$name-bin" "$app_path"
  else
    warn "$name-bin" "missing $app"
  fi

  check_wayland_wrapper_common "$wrapper" "$path"
}

check_user_service_active() {
  local service=$1 state
  state=$(systemctl --user is-active "$service" 2>/dev/null || true)
  if [ "$state" = active ]; then
    ok "$service" active
  else
    fail "$service" "${state:-missing}"
  fi
}

check_screen_share() {
  local portal_file portal_env wrapper path

  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    ok wayland-display "$WAYLAND_DISPLAY"
  else
    fail wayland-display missing
  fi

  if [ "${XDG_CURRENT_DESKTOP:-}" = Hyprland ]; then
    ok current-desktop Hyprland
  else
    fail current-desktop "${XDG_CURRENT_DESKTOP:-missing}"
  fi

  if hyprctl monitors -j >/dev/null 2>&1; then
    ok hyprctl-monitors ok
  else
    fail hyprctl-monitors failed
  fi

  check_user_service_active xdg-desktop-portal-hyprland.service
  check_user_service_active xdg-desktop-portal.service

  portal_file="$HOME/.local/share/xdg-desktop-portal/portals/hyprland.portal"
  if [ -r "$portal_file" ] && grep -Fq ScreenCast "$portal_file"; then
    ok hyprland-portal ScreenCast
  else
    fail hyprland-portal "missing ScreenCast in $portal_file"
  fi

  portal_env=$(systemctl --user show xdg-desktop-portal.service -p Environment --value 2>/dev/null || true)
  case "$portal_env" in
    *"$HOME/.local/share"*) ok portal-xdg-data "$HOME/.local/share" ;;
    *) fail portal-xdg-data "missing $HOME/.local/share" ;;
  esac

  for wrapper in chrome-wayland brave-wayland; do
    path=$(command -v "$wrapper" 2>/dev/null || true)
    if [ -n "$path" ] && grep -Fq WebRTCPipeWireCapturer "$path"; then
      ok "$wrapper" WebRTCPipeWireCapturer
    else
      fail "$wrapper" "missing WebRTCPipeWireCapturer"
    fi
  done
}

check_qs_menu_smoke_latest() {
  local base latest summary contact failed max_age now mtime age qml_file qml_mtime panel
  local panels=()

  base="${QS_MENU_SMOKE_BASE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/quickshell/menu-smoke}"
  latest="${QS_MENU_SMOKE_LATEST:-$base/latest}"
  summary="$latest/summary.tsv"
  contact="$latest/contact.png"
  max_age="${QS_MENU_SMOKE_MAX_AGE_SECONDS:-86400}"

  if [ ! -r "$summary" ]; then
    warn qs-menu-smoke-latest "not run yet"
    return
  fi

  mtime=$(stat -c %Y "$summary" 2>/dev/null || printf 0)
  if [ "$max_age" -gt 0 ] 2>/dev/null; then
    now=$(date +%s)
    age=$((now - mtime))
    if [ "$age" -gt "$max_age" ]; then
      fail qs-menu-smoke-latest "stale ${age}s" "qs-menu-smoke"
      return
    fi
  fi

  qml_file="${QUICKSHELL_FILE:-$HOME/.config/quickshell/marcelof/shell.qml}"
  qml_mtime=$(stat -c %Y "$qml_file" 2>/dev/null || printf 0)
  if [ "$qml_mtime" -gt "$mtime" ]; then
    fail qs-menu-smoke-latest "older than $qml_file" "qs-menu-smoke"
    return
  fi

  mapfile -t panels < <(qs-menu-smoke --list)
  for panel in "${panels[@]}"; do
    if ! awk -F "\t" -v panel="$panel" '$1 == panel && $2 == "ok" { found=1 } END { exit !found }' "$summary"; then
      fail qs-menu-smoke-latest "missing $panel panel" "qs-menu-smoke $panel"
      return
    fi
  done

  if [ ! -s "$contact" ]; then
    fail qs-menu-smoke-latest "missing contact sheet" "qs-menu-smoke"
    return
  fi

  failed=$(awk -F "\t" 'NR > 1 && $2 != "ok" { count++ } END { print count + 0 }' "$summary")
  if [ "$failed" -gt 0 ]; then
    fail qs-menu-smoke-latest "$failed failed panel(s)" "qs-menu-smoke"
  else
    ok qs-menu-smoke-latest "$summary"
  fi
}

check_board_status() {
  local config="${BOARD_CONFIG:-$HOME/.config/board/board.toml}"
  if [ -r "$config" ]; then
    ok board-config "$config"
  else
    fail board-config "missing $config" "home -y"
    return
  fi

  if board --config "$config" render quickshell quickshell-bar >/dev/null 2>&1; then
    ok board-render quickshell-bar
  else
    fail board-render "quickshell-bar failed" "board --config $config render quickshell quickshell-bar"
  fi
}

check_audio_status() {
  local output
  if ! output=$(audioctl status 2>&1); then
    fail audioctl "status failed"
    printf '%s\n' "$output"
    return
  fi

  ok audioctl status
  if printf '%s\n' "$output" | grep -q '^icon: '; then
    ok audioctl-icon present
  else
    fail audioctl-icon missing
  fi

  if printf '%s\n' "$output" | grep -q '^helper: running'; then
    if printf '%s\n' "$output" | grep -q '^display: '; then
      ok audioctl-display present
    else
      fail audioctl-display "helper running without display"
    fi
  else
    ok audioctl-display "not required while stopped"
  fi
}

check_notification_smoke_status() {
  if desktop-notification-smoke --status; then
    ok notification-smoke ready
  else
    fail notification-smoke "not ready" "desktop-notification-smoke --status"
  fi
}

section "required commands"
for cmd in hypr-session hypr-keys hypr-term qs-bar qs-menu-smoke desktop-reload desktop-notification-smoke desktop-inhibit board identify compare montage audioctl check-audio-streams cliphist-menu screenshot-wayland wallpaper-wayland screen-record-wayland monitor desktop-accept desktop-startup-report chrome-wayland brave-wayland desktop-package-audit check-wayland-no-x11 script-picker walker-websearch desktop-privacy-status desktop-osd external-brightness media-now-playing notification-focus-app; do
  check_cmd "$cmd" yes
done
check_cmd walker yes
check_cmd gum yes
check_cmd fzf yes

section "pickers"
run_required script-picker script-picker --status
run_required walker-websearch walker-websearch --status

section "session smoke"
run_required hypr-session hypr-session smoke

section "package intent"
run_required desktop-package-audit desktop-package-audit

section "wayland archive guard"
run_required check-wayland-no-x11 check-wayland-no-x11

section "profile"
current_profile

section "quickshell"
run_required qs-bar qs-bar status
check_board_status
check_qs_menu_smoke_latest

section "audio"
check_audio_status
run_required audioctl-self-test audioctl self-test
run_required media-now-playing media-now-playing
run_required desktop-osd-self-test desktop-osd self-test
if command -v check-audio-streams >/dev/null 2>&1; then
  check-audio-streams || true
fi

section "notifications"
check_notification_smoke_status

section "clipboard"
run_required cliphist-menu cliphist-menu status

section "screenshots"
run_required screenshot-wayland screenshot-wayland status

section "wallpaper"
run_required wallpaper-wayland wallpaper-wayland status

section "screen record"
run_required screen-record-wayland screen-record-wayland status

section "monitors"
run_required monitor monitor status

section "privacy"
run_required desktop-privacy-status desktop-privacy-status status
run_required desktop-privacy-status-self-test desktop-privacy-status self-test
run_required external-brightness-self-test external-brightness self-test

section "screen share"
check_screen_share

section "browser wrappers"
check_browser_wrapper chrome chrome-wayland google-chrome-stable
check_browser_wrapper brave brave-wayland brave-browser-stable
check_electron_wrapper slack slack-wayland slack
check_electron_wrapper discord discord-wayland discord
check_electron_wrapper obsidian obsidian-wayland obsidian
check_electron_wrapper 1password 1password-wayland 1password

exit "$status"
