#!/bin/sh

# Gopass clipboard clear helper.
# Receives the entry name as $1 and the checksum on stdin.
# Clipboard clearing stays disabled; only remove the history-suppression marker.

BACKEND="${CLIP_BACKEND:-wl}"
[ "$BACKEND" = gpaste ] && BACKEND=wl

case "$BACKEND" in
    wl)
        rm -f "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/gopass-clipboard-sensitive"
        exit 0
        ;;
    gpaste)
        echo "gopass-clip-clear: gpaste backend disabled because it breaks Wayland clipboard ownership" >&2
        exit 1
        ;;
    copyq)
        exit 0
        ;;
    *)
        echo "gopass-clip-clear: unknown CLIP_BACKEND: $BACKEND" >&2
        exit 1
        ;;
esac
