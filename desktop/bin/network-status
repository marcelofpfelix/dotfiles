#!/usr/bin/env bash
set -euo pipefail

wifi_state() {
    nmcli radio wifi 2>/dev/null || printf 'unknown\n'
}

primary_connection() {
    nmcli -t -f DEVICE,TYPE,STATE,CONNECTION dev status 2>/dev/null | awk -F: '
        $3 ~ /^connected/ && ($2 == "wifi" || $2 == "ethernet") {
            type = $2 == "wifi" ? "Wi-Fi" : "Ethernet"
            name = ($4 != "" && $4 !~ "^ERR_") ? $4 : "connected"
            print type ": " name
            found = 1
            exit
        }
        END { if (!found) print "No primary network" }
    '
}

wifi_signal() {
    nmcli -t -f ACTIVE,SIGNAL dev wifi 2>/dev/null | awk -F: '$1 == "yes" { print $2; found = 1; exit } END { if (!found) print "" }'
}

wifi_icon() {
    local signal=${1:-}
    if [ -z "$signal" ]; then
        printf '󰖪\n'
    elif [ "$signal" -ge 80 ]; then
        printf '󰤨\n'
    elif [ "$signal" -ge 60 ]; then
        printf '󰤥\n'
    elif [ "$signal" -ge 40 ]; then
        printf '󰤢\n'
    elif [ "$signal" -ge 20 ]; then
        printf '󰤟\n'
    else
        printf '󰤯\n'
    fi
}

wifi_channel() {
    nmcli -t -f ACTIVE,CHAN dev wifi 2>/dev/null | awk -F: '$1 == "yes" { print $2; found = 1; exit } END { if (!found) print "" }'
}

wifi_band() {
    local channel=${1:-}
    [ -n "$channel" ] || return 0
    if [ "$channel" -le 14 ] 2>/dev/null; then
        printf '2.4GHz ch%s\n' "$channel"
    elif [ "$channel" -ge 36 ] 2>/dev/null; then
        printf '5/6GHz ch%s\n' "$channel"
    else
        printf 'ch%s\n' "$channel"
    fi
}

local_ip() {
    ip -4 route get 1.1.1.1 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "src") { print $(i + 1); exit } }'
}

dns_summary() {
    if command -v resolvectl >/dev/null 2>&1; then
        resolvectl dns 2>/dev/null | awk -F: 'NF > 1 { gsub(/^ +| +$/, "", $2); if ($2 != "") { print $2; exit } }'
    else
        awk '/^nameserver / { print $2 }' /etc/resolv.conf 2>/dev/null | paste -sd' ' -
    fi
}

primary_device() {
    nmcli -t -f DEVICE,TYPE,STATE dev status 2>/dev/null | awk -F: '$3 ~ /^connected/ && ($2 == "wifi" || $2 == "ethernet") { print $1; exit }'
}

public_ip() {
    [ "${NETWORK_STATUS_PUBLIC_IP:-1}" = "1" ] || return 0
    curl -fsS --max-time 2 https://api.ipify.org 2>/dev/null || true
}


devices() {
    nmcli -t -f DEVICE,TYPE,STATE,CONNECTION dev status 2>/dev/null | awk -F: "
        function icon(type) {
            if (type == \"wifi\") return \"󰖩\"
            if (type == \"ethernet\") return \"󰈀\"
            if (type == \"tun\") return \"󰒄\"
            if (type == \"bridge\") return \"󰌘\"
            if (type == \"loopback\") return \"󰕘\"
            return \"󰛳\"
        }
        function label_type(type) {
            if (type == \"wifi\") return \"Wi-Fi\"
            if (type == \"wifi-p2p\") return \"Wi-Fi P2P\"
            if (type == \"ethernet\") return \"Ethernet\"
            return type
        }
        function clean(value) {
            return (value == \"\" || value ~ /^ERR_/) ? \"\" : value
        }
        {
            connection = clean(\$4)
            line = sprintf(\"%s %s %s: %s\", icon(\$2), label_type(\$2), \$1, \$3)
            if (connection != \"\") line = line \" (\" connection \")\"
            print line
        }
    " || ip -brief addr
}
case "${1:-status}" in
    bar)
        signal=$(wifi_signal)
        icon=$(wifi_icon "$signal")
        if [ -n "$signal" ]; then
            printf '%s %s%%\n' "$icon" "$signal"
        else
            printf '%s\n' "$icon"
        fi
        ;;
    status)
        signal=$(wifi_signal)
        if [ -n "$signal" ]; then
            printf '%s • Wi-Fi %s • %s %s%%\n' "$(primary_connection)" "$(wifi_state)" "$(wifi_icon "$signal")" "$signal"
        else
            printf '%s • Wi-Fi %s\n' "$(primary_connection)" "$(wifi_state)"
        fi
        ;;
    details)
        signal=$(wifi_signal)
        channel=$(wifi_channel)
        band=$(wifi_band "$channel")
        printf '%s\n' "$(primary_connection)"
        printf 'Wi-Fi: %s' "$(wifi_state)"
        [ -n "$signal" ] && printf ' • %s %s%%' "$(wifi_icon "$signal")" "$signal"
        [ -n "$band" ] && printf ' • %s' "$band"
        printf '\n'
        ip_addr=$(local_ip)
        if [ -n "$ip_addr" ]; then
            printf 'Local IP: %s\n' "$ip_addr"
        fi
        dns=$(dns_summary || true)
        if [ -n "$dns" ]; then
            printf 'DNS: %s\n' "$dns"
        fi
        pub_ip=$(public_ip)
        if [ -n "$pub_ip" ]; then
            printf 'Public IP: %s\n' "$pub_ip"
        fi
        printf '\nDevices:\n'
        devices
        ;;
    devices)
        devices
        ;;
    wifi-toggle)
        if [ "$(wifi_state)" = "enabled" ]; then
            nmcli radio wifi off
        else
            nmcli radio wifi on
        fi
        ;;
    reconnect)
        device=$(primary_device)
        [ -n "$device" ] || exit 0
        nmcli dev disconnect "$device" >/dev/null 2>&1 || true
        nmcli dev connect "$device"
        ;;
    *)
        printf 'use: network-status [bar|status|details|devices|wifi-toggle|reconnect]\n' >&2
        exit 2
        ;;
esac
