#!/usr/bin/env bash
set -euo pipefail

if [[ ${1:-} == --self-test ]]; then
    profile_dir=${HYPR_KEYS_PROFILE_DIR:-$HOME/.config/hypr/profiles}
    default=$(HYPR_KEYS_PROFILE_DIR="$profile_dir" "$0" default)
    omarchy=$(HYPR_KEYS_PROFILE_DIR="$profile_dir" "$0" omarchy)
    grep -Fqx $'Win+H\tFocus window' <<<"$default"
    grep -Fqx $'Win+Shift+0\tMove window to workspace' <<<"$default"
    grep -Fqx $'Win+Ctrl+MINUS\tResize window' <<<"$omarchy"
    grep -Fqx $'Win+MouseLeft\tDrag window' <<<"$omarchy"
    ! grep -Eq 'code:(20|21)|mouse:(272|273|274)' <<<"$omarchy"
    printf 'hypr-keys self-test: ok\n'
    exit 0
fi

detect_profile() {
    if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || ! command -v hyprctl >/dev/null 2>&1 || ! command -v jq >/dev/null 2>&1; then
        printf 'default'
        return
    fi

    local kb_options gaps_out
    kb_options=$(hyprctl getoption input:kb_options -j 2>/dev/null | jq -r '.str // ""' 2>/dev/null || true)
    gaps_out=$(hyprctl getoption general:gaps_out -j 2>/dev/null | jq -r '.css // ""' 2>/dev/null || true)
    if [[ "$kb_options" == *compose:caps* || "$gaps_out" == 16* ]]; then
        printf 'omarchy'
    else
        printf 'default'
    fi
}

profile="${1:-${HYPR_PROFILE:-$(detect_profile)}}"
profile_dir="${HYPR_KEYS_PROFILE_DIR:-$HOME/.config/hypr/profiles}"
file="$profile_dir/$profile.lua"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_lib="${script_dir%/bin}/lib/lib_qs_menus.sh"
if [ -r "$repo_lib" ]; then
    . "$repo_lib"
elif [ -r "${LIBS_DIR:-$HOME/lib}/lib_qs_menus.sh" ]; then
    . "${LIBS_DIR:-$HOME/lib}/lib_qs_menus.sh"
fi

if [ ! -r "$file" ] && [ -r "desktop/.config/hypr/profiles/$profile.lua" ]; then
    file="desktop/.config/hypr/profiles/$profile.lua"
fi

if [ ! -r "$file" ]; then
    printf 'HYPR_PROFILE\t%s not found\n' "$profile"
    exit 0
fi

pretty_key() {
    local key=$1
    key=${key# } ; key=${key% }
    key=${key#\"} ; key=${key%\"}
    key=${key//mod .. \"/SUPER}
    key=${key//\" .. key/1..0}
    key=${key//\"/}
    key=${key// + /+}
    key=${key//SUPER/Win}
    key=${key//SHIFT/Shift}
    key=${key//CTRL/Ctrl}
    key=${key//ALT/Alt}
    key=${key//RETURN/Enter}
    key=${key//SPACE/Space}
    key=${key//TAB/Tab}
    key=${key//ESCAPE/Esc}
    key=${key//SLASH/\/}
    key=${key//PERIOD/.}
    key=${key//LEFT/Left}
    key=${key//RIGHT/Right}
    key=${key//UP/Up}
    key=${key//DOWN/Down}
    key=${key//comma/,}
    key=${key//mouse_down/WheelDown}
    key=${key//mouse_up/WheelUp}
    key=${key//mouse:272/MouseLeft}
    key=${key//mouse:273/MouseRight}
    key=${key//mouse:274/MouseMiddle}
    key=${key//code:20/MINUS}
    key=${key//code:21/EQUAL}
    printf '%s' "$key"
}

pretty_action() {
    local line=$1 action=$2 menu
    if declare -p qs_menu_panels >/dev/null 2>&1 && command -v qs_menu_label >/dev/null 2>&1; then
        for menu in "${qs_menu_panels[@]}"; do
            case "$line" in
                *"qbar $menu"*|*"qs(\"$menu\")"*) qs_menu_label "$menu"; return ;;
            esac
        done
    fi
    case "$line" in
        *'sh(terminal)'*) printf 'Terminal' ;;
        *'sh(launcher)'*) printf 'Apps' ;;
        *'sh(root_menu)'*) printf 'Root menu' ;;
        *'qbar keybindings'*) printf 'Keybindings' ;;
        *'common.actions.keybindings'*) printf 'Keybindings' ;;
        *'qbar power'*) printf 'Session menu' ;;
        *'qbar controls'*) printf 'Controls' ;;
        *'universal_paste'*) printf 'Paste' ;;
        *'noop()'*) printf 'No action' ;;
        *'function() end'*) printf 'No action' ;;
        *'qbar network'*) printf 'Network' ;;
        *'qbar clipboard'*) printf 'Clipboard history' ;;
        *'qbar websearch'*) printf 'Web search' ;;
        *'qbar toggle'*) printf 'Toggle bar' ;;
        *'qbar lock'*) printf 'Lock' ;;
        *'qs("power")'*) printf 'Session menu' ;;
        *'qs("controls")'*) printf 'Controls' ;;
        *'qs("toggle")'*) printf 'Toggle bar' ;;
        *'qs("lock")'*) printf 'Lock' ;;
        *'qs("websearch")'*) printf 'Web search' ;;
        *'qs("dnd")'*) printf 'Toggle DND' ;;
        *'notice time'*) printf 'Time notice' ;;
        *'notice battery'*) printf 'Battery notice' ;;
        *'notice weather'*) printf 'Weather notice' ;;
        *'screenshot-wayland edit'*) printf 'Screenshot' ;;
        *'screenshot("edit")'*) printf 'Screenshot' ;;
        *'hyprpicker'*) printf 'Color picker' ;;
        *'hypr-scratch toggle'*) printf 'Scratchpad' ;;
        *'hypr-scratch move'*) printf 'Move window to scratchpad' ;;
        *'window.close'*) printf 'Close window' ;;
        *'dsp.focus({ direction'*) printf 'Focus window' ;;
        *'window.move({ direction'*) printf 'Move window' ;;
        *'window.swap'*) printf 'Swap window' ;;
        *'workspace.move({ monitor'*) printf 'Move workspace to monitor' ;;
        *'focus({ monitor'*) printf 'Focus monitor' ;;
        *'focus({ workspace'*) printf 'Workspace' ;;
        *'window.move({ workspace'*) printf 'Move window to workspace' ;;
        *'resizeactive'*) printf 'Resize window' ;;
        *'group.toggle'*) printf 'Toggle group' ;;
        *'out_of_group'*) printf 'Ungroup window' ;;
        *'into_group'*) printf 'Move window into group' ;;
        *'group.next'*) printf 'Next grouped window' ;;
        *'group.prev'*) printf 'Previous grouped window' ;;
        *'layout("splith")'*) printf 'Horizontal split' ;;
        *'layout("splitv")'*) printf 'Vertical split' ;;
        *'layout("togglesplit")'*) printf 'Toggle split' ;;
        *'fullscreenstate'*) printf 'Fullscreen state' ;;
        *'fullscreen({ mode = "maximized"'*) printf 'Maximize window' ;;
        *'fullscreen'*) printf 'Fullscreen' ;;
        *'window.float'*) printf 'Toggle floating' ;;
        *'window.pseudo'*) printf 'Pseudo tile' ;;
        *'togglefloating; hyprctl dispatch pin'*) printf 'Toggle pinned floating' ;;
        *'hypr-session reload'*) printf 'Reload Hyprland' ;;
        *'common.actions.hypr_reload'*) printf 'Reload Hyprland' ;;
        *'cyclenext prev'*) printf 'Previous window' ;;
        *'cyclenext'*) printf 'Next window' ;;
        *'focus parent has no dwindle equivalent'*) printf 'Focus parent unavailable' ;;
        *'resize mode is mapped'*) printf 'Resize mode notice' ;;
        *'monitor'*) printf 'Display settings' ;;
        *'gnome-calculator'*) printf 'Calculator' ;;
        *'hypr-term popup-tmux'*) printf 'Tmux popup' ;;
        *'terminal .. " popup-tmux"'*) printf 'Tmux popup' ;;
        *'tmux list-keys'*) printf 'Tmux keys' ;;
        *'tmx'*) printf 'Tmux launcher' ;;
        *'about:blank'*) printf 'Browser' ;;
        *'universal_clipboard_shortcut("CTRL", "C"'*) printf 'Copy' ;;
        *'universal_clipboard_shortcut("CTRL", "V"'*) printf 'Paste' ;;
        *'send_shortcut_once("CTRL", "X"'*) printf 'Cut' ;;
        *'htop'*) printf 'System monitor' ;;
        *'nautilus'*) printf 'Files' ;;
        *'nvim'*) printf 'Neovim' ;;
        *'window.drag'*) printf 'Drag window' ;;
        *'window.resize'*) printf 'Resize window' ;;
        *'lazydocker'*) printf 'Lazydocker' ;;
        *'obsidian'*) printf 'Obsidian' ;;
        *'typora'*) printf 'Typora' ;;
        *'desktop-osd volume'*) printf 'Volume' ;;
        *'osd("volume-up")'*) printf 'Volume up' ;;
        *'osd("volume-down")'*) printf 'Volume down' ;;
        *'osd("volume-fine-up")'*) printf 'Fine volume up' ;;
        *'osd("volume-fine-down")'*) printf 'Fine volume down' ;;
        *'desktop-osd mute'*) printf 'Mute volume' ;;
        *'osd("mute")'*) printf 'Mute volume' ;;
        *'desktop-osd mic-mute'*) printf 'Mute mic' ;;
        *'osd("mic-mute")'*) printf 'Mute mic' ;;
        *'desktop-osd kbd'*) printf 'Keyboard brightness' ;;
        *'osd("kbd-up")'*) printf 'Keyboard brightness up' ;;
        *'osd("kbd-down")'*) printf 'Keyboard brightness down' ;;
        *'desktop-osd brightness-fine-up'*) printf 'Screen brightness fine up' ;;
        *'osd("brightness-fine-up")'*) printf 'Screen brightness fine up' ;;
        *'desktop-osd brightness-fine-down'*) printf 'Screen brightness fine down' ;;
        *'osd("brightness-fine-down")'*) printf 'Screen brightness fine down' ;;
        *'desktop-osd brightness-up'*) printf 'Screen brightness up' ;;
        *'osd("brightness-up")'*) printf 'Screen brightness up' ;;
        *'desktop-osd brightness-down'*) printf 'Screen brightness down' ;;
        *'osd("brightness-down")'*) printf 'Screen brightness down' ;;
        *'desktop-osd brightness-max'*) printf 'Max brightness' ;;
        *'osd("brightness-max")'*) printf 'Max brightness' ;;
        *'desktop-osd brightness-min'*) printf 'Min brightness' ;;
        *'osd("brightness-min")'*) printf 'Min brightness' ;;
        *'pactl set-sink-volume'*) printf 'Volume' ;;
        *'set-sink-mute'*) printf 'Mute volume' ;;
        *'set-source-mute'*) printf 'Mute mic' ;;
        *'playerctl next'*) printf 'Next track' ;;
        *'playerctl previous'*) printf 'Previous track' ;;
        *'audioctl play-pause-all'*) printf 'Start/stop saved audio' ;;
        *'common.actions.play_pause_all'*) printf 'Start/stop saved audio' ;;
        *'KbdBrightness'*) printf 'Keyboard brightness' ;;
        *'MonBrightness'*) printf 'Screen brightness' ;;
        *'bri +1'*) printf 'Screen brightness fine up' ;;
        *'bri -1'*) printf 'Screen brightness fine down' ;;
        *'bri +10'*) printf 'Screen brightness up' ;;
        *'bri -10'*) printf 'Screen brightness down' ;;
        *'brightnessctl set 100%'*) printf 'Max brightness' ;;
        *'brightnessctl set 1%'*) printf 'Min brightness' ;;
        *)
            action=${action# } ; action=${action% }
            action=${action#sh\(} ; action=${action%\)}
            action=${action#\"} ; action=${action%\"}
            printf '%s' "$action"
            ;;
    esac
}

printf 'Profile\t%s\n' "$profile"
seen=''
profile_text=$(<"$file")
emit_row() {
    local row="$1\t$2"
    case "$seen" in *$'\n'"$row"$'\n'*) return ;; esac
    seen="$seen"$'\n'"$row"$'\n'
    printf '%b\n' "$row"
}

while IFS= read -r line; do
    line=${line%%--*}
    case "$line" in
        *'common.bind_direction_keys('*)
            prefix=Win
            [[ $line == *' + SHIFT'* ]] && prefix+='+Shift'
            [[ $line == *'vim_directions'* ]] && keys=(H J K L) || keys=(Left Down Up Right)
            if [[ $line == *'window.swap'* ]]; then
                action='Swap window'
            elif [[ $line == *'window.move'* ]]; then
                action='Move window'
            else
                action='Focus window'
            fi
            for key in "${keys[@]}"; do emit_row "$prefix+$key" "$action"; done
            continue
            ;;
        *'common.bind_workspace_numbers('*)
            for i in {1..10}; do
                key=$i; (( i == 10 )) && key=0
                [[ $profile_text == *'  focus = '* ]] && emit_row "Win+$key" 'Workspace'
                [[ $profile_text == *'  move = '* ]] && emit_row "Win+Shift+$key" 'Move window to workspace'
                [[ $profile_text == *'  move_no_follow = '* ]] && emit_row "Win+Shift+Alt+$key" 'Move window to workspace without following'
            done
            continue
            ;;
    esac
    [[ $line == *"function bind_app("* ]] && continue
    case "$line" in
        *'function bind_app('*) continue ;;
        *'hl.bind('*|*'bind_app('*) ;;
        *) continue ;;
    esac
    rest=${line#*(}
    key=${rest%%,*}
    action=${rest#*,}
    [ "${key// /}" = keys ] && continue
    key=$(pretty_key "$key")
    [ -n "$key" ] || continue
    emit_row "$key" "$(pretty_action "$line" "$action")"
done <"$file"
