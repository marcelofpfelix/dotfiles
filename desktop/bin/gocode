#!/usr/bin/env bash

set -euo pipefail

workspace() {
    if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        echo "Error: gocode requires Hyprland." >&2
        exit 1
    fi
    hyprctl dispatch workspace "$1"
}

workspace 2
zed ~/work.code-workspace &
wezterm start -- tmuxa dev &

# for personal
# chrome-wayland --profile-directory="Profile 1" &
