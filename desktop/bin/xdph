#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/share/dotfiles-nix/desktop/bin:$HOME/bin:$HOME/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:$PATH"

run_portal() {
    local bin="$1"
    shift
    exec hypr-clean-env "$bin" "$@"
}

if command -v xdg-desktop-portal-hyprland >/dev/null 2>&1; then
    run_portal "$(command -v xdg-desktop-portal-hyprland)" "$@"
fi

for candidate in /nix/store/*-xdg-desktop-portal-hyprland-*/libexec/xdg-desktop-portal-hyprland; do
    [ -x "$candidate" ] && run_portal "$candidate" "$@"
done

printf "xdg-desktop-portal-hyprland not found\n" >&2
exit 127
