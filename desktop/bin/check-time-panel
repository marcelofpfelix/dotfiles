#!/usr/bin/env bash
set -euo pipefail

now=$(date +%s)
printf 'Timezones\n'
TZ=Europe/Lisbon date '+  Lisbon   %a %d %b %H:%M:%S %Z'
TZ=UTC date '+  UTC      %a %d %b %H:%M:%S %Z'
TZ=America/New_York date '+  New York %a %d %b %H:%M:%S %Z'
TZ=America/Los_Angeles date '+  SF       %a %d %b %H:%M:%S %Z'
printf '\nTimestamps\n'
printf '  Unix     %s\n' "$now"
printf '  Hex      0x%x\n' "$now"
printf '\nCalendar\n'
cal -m 2>/dev/null | sed 's/^/  /'

if command -v khal >/dev/null 2>&1; then
    events=$(khal list today 7d 2>/dev/null | sed '/^[[:space:]]*$/d' | head -n 8 || true)
    if [ -n "$events" ]; then
        printf '\nEvents\n'
        printf '%s\n' "$events" | sed 's/^/  /'
    fi
fi
