#!/usr/bin/env bash
set -euo pipefail

now=$(date +%s)
printf 'Timezones\n'
TZ=Europe/Lisbon date '+  Lisbon %a %d %b %H:%M %Z'
TZ=UTC date '+  UTC    %a %d %b %H:%M %Z'
TZ=America/New_York date '+  NY     %a %d %b %H:%M %Z'
TZ=America/Los_Angeles date '+  SF     %a %d %b %H:%M %Z'
printf '\nTimestamps\n'
printf '  Unix   %s\n' "$now"
printf '  Hex    0x%x\n' "$now"
if uptime_text=$(uptime -p 2>/dev/null | sed 's/^up //'); then
    [ -n "$uptime_text" ] && printf '  Up     %s\n' "$uptime_text"
fi
