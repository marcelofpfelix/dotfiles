#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.nix-profile/bin:$HOME/bin:$HOME/.local/bin:$PATH"
export QT_QUICK_BACKEND="${QT_QUICK_BACKEND:-software}"

qs_bin="${QS_BIN:-$HOME/.nix-profile/bin/qs}"
quickshell_bin="${QUICKSHELL_BIN:-$HOME/.nix-profile/bin/quickshell}"
config_path="${QUICKSHELL_PATH:-$HOME/.config/quickshell/marcelof/shell.qml}"
log_file="${QS_BAR_LOG:-/tmp/qs-bar.log}"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_lib="${script_dir%/bin}/lib/lib_qs_menus.sh"
if [ -r "$repo_lib" ]; then
  . "$repo_lib"
else
  . "${LIBS_DIR:-$HOME/lib}/lib_qs_menus.sh"
fi

quickshell_pids() {
  ps -eo pid=,args= | awk -v cfg="$config_path" 'index($0, "quickshell") && index($0, "--path " cfg) { print $1 }'
}

list_instances() {
  ps -eo pid=,args= | awk -v cfg="$config_path" 'index($0, "quickshell") && index($0, "--path " cfg) { pid=$1; $1=""; sub(/^ /, ""); printf "Process %s:%s\n", pid, $0 }'
}

usage() {
  printf 'use: qs-bar [start|stop|restart|reload|status|runtime-prune|toggle|show|hide|tray|controls|calendar|work-inbox|personal-dashboard|notifications|power|inhibit|keybindings|clipboard|clipboard-update|passmenu|websearch|media|screen|wallpaper|launcher|settings|dnd|osd-volume|osd-brightness|osd-kbd|osd-mic|close-panels]\n' >&2
}

kill_all() {
  local pids

  pids=$(quickshell_pids || true)
  [ -n "$pids" ] || return 0
  kill $pids 2>/dev/null || true
}

runtime_prune() {
  local force root path found
  force=0
  [ "${1:-}" = "--force" ] && force=1
  root="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshell/by-path"
  [ -d "$root" ] || return 0
  found=0
  for path in "$root"/*; do
    [ -L "$path" ] || continue
    [ ! -e "$path" ] || continue
    found=1
    if [ "$force" -eq 1 ]; then
      unlink -- "$path"
      printf "removed %s\n" "$path"
    else
      printf "would-remove %s\n" "$path"
    fi
  done
  [ "$found" -eq 1 ] || printf "no stale quickshell by-path entries\n"
}

call_ipc() {
  local output target
  target=$1
  shift

  if output=$("$qs_bin" ipc --path "$config_path" --any-display call "$target" "$@" 2>&1); then
    if grep -Fq "Not ready to accept queries yet." <<<"$output"; then
      printf "%s\n" "$output" >>"$log_file"
      return 1
    fi
    [ -z "$output" ] || printf "%s\n" "$output"
    return 0
  fi

  printf "%s\n" "$output" >&2
  return 1
}

restart_quickshell() {
  kill_all
  sleep 0.3
  start
}

ipc() {
  call_ipc bar "$1" || { restart_quickshell; sleep 0.8; call_ipc bar "$1"; }
}

ipc_target() {
  local target=$1
  shift
  call_ipc "$target" "$@" || { restart_quickshell; sleep 0.8; call_ipc "$target" "$@"; }
}

running() {
  [ -n "$(quickshell_pids || true)" ]
}

start() {
  running && return 0
  "$quickshell_bin" --path "$config_path" --no-duplicate --daemonize >>"$log_file" 2>&1 || true
  sleep 0.3
  running && return 0
  "$quickshell_bin" --path "$config_path" --daemonize >>"$log_file" 2>&1 || true
  sleep 0.3
  running
}

case "${1:-status}" in
  start) start ;;
  stop) kill_all ;;
  restart|reload) restart_quickshell ;;
  status) list_instances ;;
  runtime-prune|prune-runtime) runtime_prune "${2:-}" ;;
  list-menus|menus) qs_menu_list ;;
  toggle|show|hide) ipc "$1" ;;
  launcher) ipc_target launcher open ;;
  tray|tray-manage) ipc trayManage ;;
  controls) ipc controls ;;
  media|audio) ipc media ;;
  screen|screenshot|record) ipc screen ;;
  wallpaper) ipc wallpaper ;;
  calendar) ipc calendar ;;
  work-inbox|work|inbox) ipc workInbox ;;
  personal-dashboard|dashboard|personal) ipc personalDashboard ;;
  settings) ipc settings ;;
  dnd) ipc dnd ;;
  osd-volume) ipc osdVolume ;;
  osd-brightness) ipc osdBrightness ;;
  osd-kbd) ipc osdKbd ;;
  osd-mic) ipc osdMic ;;
  notifications) ipc notifications ;;
  network) ipc_target network toggle ;;
  websearch) ipc_target websearch toggle ;;
  lock) ipc_target lock lock ;;
  power|session) ipc power ;;
  power-confirm) ipc_target session confirmReboot ;;
  inhibit|stay-awake) ipc inhibit ;;
  keybindings|keys) ipc keybindings ;;
  clipboard) ipc clipboard ;;
  clipboard-update) ipc clipboardUpdate ;;
  passmenu) ipc_target passmenu open copy username gopass ;;
  close-panels) ipc closePanels ;;
  *) usage; exit 2 ;;
esac
