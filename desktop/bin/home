#!/usr/bin/env bash

################################################################################
#                                 FILE INFO
# ansible-playbook to update the dotfiles into
################################################################################

  # change to local directory
cd "$(dirname $0)"
  # load lib
# shellcheck source=.../default/lib/lib_utils.sh
. ../lib/lib_utils.sh

CLI="""
use: home
long: |
  Deploy home dotfiles repo
  Using the embedded homelab Ansible project
flags:
  - use: target
    short: Target server
    alias: t
    type: string
  - use: yes
    short: yesman mode (no questions asked, using defaults)
    alias: y
    type: bool
  - use: work
    short: use work inventory
    alias: w
    type: bool
  - use: fast
    short: fast deploy
    alias: f
    type: bool
  - use: dst
    short: override home_dst (default /opt/telproxy)
    alias: d
    type: string
"""
. ../lib/lib_cli.sh


if git_repo_path_bool "${WORKTREE:-true}"; then
    gwt_root="${GWT_REPOS_ROOT:-$HOME/gwt}"
    dotfiles="$gwt_root/marcelofpfelix/dotfiles/main"
    homework="$gwt_root/marcelofpfelix/homework/main"
    workdir="$gwt_root/team-telnyx/tel-proxy/marcelo/home"
else
    dotfiles="$(git_repo_path marcelofpfelix dotfiles)"
    homework="$(git_repo_path marcelofpfelix homework)"
    workdir="$(git_repo_path team-telnyx tel-proxy home)"
fi

homelab="${dotfiles}/homelab"

homelab_overlay=""
homelab_run="$homelab"
inventory_overlay=""

cleanup_homelab_overlay() {
    if [ -n "$homelab_overlay" ] && [ -d "$homelab_overlay" ]; then
        rm -rf "$homelab_overlay"
    fi
    if [ -n "$inventory_overlay" ] && [ -f "$inventory_overlay" ]; then
        rm -f "$inventory_overlay"
    fi
}

prepare_homelab_overlay() {
    private_homelab="${homework}/homelab"

    if [ ! -d "$private_homelab" ]; then
        homelab_run="$homelab"
        return
    fi

    homelab_overlay="$(mktemp -d "${TMPDIR:-/tmp}/home-homelab.XXXXXX")" || exit
    trap cleanup_homelab_overlay EXIT

    rsync -a \
        --exclude .git \
        --exclude .venv \
        --exclude .ansible \
        --exclude .serena \
        "${homelab}/" "$homelab_overlay/" || exit
    rsync -a "${private_homelab}/" "$homelab_overlay/" || exit

    homelab_run="$homelab_overlay"
}

local_copy() {
    # copy the dotfiles to the local directory
    rsync -a --keep-dirlinks "${dotfiles}/default/" "$HOME/"
    rsync -a --keep-dirlinks "${dotfiles}/desktop/" "$HOME/"

    # GnuPG refuses group/world-accessible homedirs.
    chmod 700 ~/.gnupg 2>/dev/null || true
    find ~/.gnupg -type f -name '*.conf' -exec chmod 600 {} + 2>/dev/null || true
    rsync -a --keep-dirlinks "${homework}/workdesk/" "$HOME/"
    if [ -x "$HOME/bin/deploy-mux" ] && [ -f "$HOME/gwt/marcelofpfelix/rush/dev/Cargo.toml" ]; then
        "$HOME/bin/deploy-mux"
    fi
    rsync -a --keep-dirlinks "${workdir}/laptop/" "$HOME/"
    rsync -a --keep-dirlinks "${workdir}/tanker/" "$HOME/"

    # ignore jinja2 templates
    rm -f ~/.ssh/config.d/work.j2
    echo "Copied dotfiles to home directory"
    exit 0
}


home() {
    cmd=${ARGS[0]}
    target=${ARGS[1]}
    yesman=${ARGS[2]}
    work=${ARGS[3]}
    fast=${ARGS[4]}
    dst=${ARGS[5]}

    println "Running cli" "home" "-t ${target}" "-y ${yesman}" "-w ${work}" "-f ${fast}" "-d ${dst}" n:b:c:b:c:c

    prepare_homelab_overlay
    cd "$homelab" || exit

    # check if $work is true
    if [ "$work" = "true" ]; then
        inventory=~/work.ini
        home_src=$homework
    else
        inventory=inventory.ini
        home_src=$dotfiles
    fi

    if [ "$fast" = "true" ]; then
        flags=" -e set_ssh=false -e set_shrc=false -e set_shrc_remote=true"
    else
        flags=" -e set_ssh=true -e set_shrc=true"
    fi

    if [ -n "$dst" ]; then
        flags="$flags -e home_dst=$dst"
    fi

    # check if $target is empty
    if [ -z "$target" ]; then
        if [ "$yesman" = "true" ]; then
            local_copy
        else
            target=$(grep -v -e '\[' -e '\#' -e '^$' $inventory | gum filter)
        fi
    fi

    if [ "$target" != "localhost" ] && ssh_user=$(ssh -G "$target" 2>/dev/null | awk '$1 == "user" { print $2; exit }') && [ -n "$ssh_user" ]; then
        inventory_overlay="$(mktemp "${TMPDIR:-/tmp}/home-inventory.XXXXXX")" || exit
        cp "$inventory" "$inventory_overlay" || exit
        printf '\n[home_ssh_resolved]\n%s ansible_user=%s\n' "$target" "$ssh_user" >> "$inventory_overlay"
        inventory="$inventory_overlay"
    fi

    log note "ansible-playbook $homelab_run/home.yml -i $inventory -e \"target=$target\" -e \"home_src=$home_src\" -e \"dotfiles=$dotfiles\" -e \"homefiles=$homework\" -e \"workfiles=$workdir\" -e homelab_secret_scope=home $flags" # service=$service
    uv run ansible-playbook "$homelab_run/home.yml" -i "$inventory" -e "target=$target" -e "home_src=$home_src" -e "dotfiles=$dotfiles" -e "homefiles=$homework" -e "workfiles=$workdir" -e homelab_secret_scope=home $flags # service=$service

}

[[ -n "$CMD" ]] && "$CMD"
