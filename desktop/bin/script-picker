#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.local/share/dotfiles-nix/desktop/bin:$HOME/bin:$HOME/.local/bin:/nix/var/nix/profiles/default/bin:$PATH"
. "${HOME}/lib/lib_picker.sh"

case "${1:-}" in
    status|--status)
        picker_status
        ;;
    *)
        prompt="${1:-Select}"
        picker_choose "$prompt"
        ;;
esac
