#!/usr/bin/env bash

################################################################################
#                                 FILE INFO
# toggle the second monitor for Hyprland
################################################################################

set -euo pipefail

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
    echo "Error: monitor requires Hyprland." >&2
    exit 1
fi

primary=eDP-1
second=DP-2

monitor_enable() {
    hyprctl -q eval "hl.monitor({ output = \"$1\", disabled = false, mode = \"preferred\", position = \"auto-right\", scale = 1 })"
}

monitor_disable() {
    hyprctl -q eval "hl.monitor({ output = \"$1\", disabled = true })"
}

connected=$(hyprctl monitors all -j 2>/dev/null | jq -r ".[] | select(.name != \"$primary\") | select(.disabled == false) | .name" | head -n 1)
available=$(hyprctl monitors all -j 2>/dev/null | jq -r ".[] | select(.name != \"$primary\") | select(.disabled == true) | .name" | head -n 1)

if [ -n "$connected" ]; then
    monitor_disable "$connected"
    echo "Disabled $connected"
elif [ -n "$available" ]; then
    monitor_enable "$available"
    echo "Connected $available to the right of $primary"
else
    monitor_disable "$second" || true
    echo "No secondary monitor detected"
fi
