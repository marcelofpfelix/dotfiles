#!/usr/bin/env bash
set -euo pipefail

primary=${MONITOR_PRIMARY:-eDP-1}
hyprctl_bin=${HYPRCTL:-hyprctl}

if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -z "${HYPRCTL:-}" ]; then
    echo "Error: monitor requires Hyprland." >&2
    exit 1
fi

monitors_json() {
    "$hyprctl_bin" monitors all -j 2>/dev/null
}

active_secondary() {
    monitors_json | jq -r --arg primary "$primary" '.[] | select(.name != $primary) | select(.disabled == false) | .name' | head -n 1
}

available_secondary() {
    monitors_json | jq -r --arg primary "$primary" '.[] | select(.name != $primary) | select(.disabled == true) | select((.availableModes // []) | length > 0) | .name' | head -n 1
}

monitor_enable() {
    "$hyprctl_bin" -q eval "hl.monitor({ output = \"$1\", disabled = false, mode = \"preferred\", position = \"auto-right\", scale = 1 })"
}

monitor_disable() {
    "$hyprctl_bin" -q eval "hl.monitor({ output = \"$1\", disabled = true })"
}

status() {
    monitors_json | jq -r --arg primary "$primary" '.[] | [.name, (if .name == $primary then "primary" else "secondary" end), (if .disabled then "disabled" else "active" end), (.description // "")] | @tsv'
}

valid_output() {
    [[ $1 =~ ^[A-Za-z0-9_.-]+$ ]]
}

panel_state() {
    local json focused brightness
    json=$(monitors_json)
    focused=$(jq -r '[.[] | select(.focused == true)][0].name // ""' <<<"$json")

    if [[ $focused =~ ^(eDP|LVDS|DSI)- ]]; then
        brightness=$(brightnessctl -m 2>/dev/null | awk -F, 'NR == 1 { gsub("%", "", $4); print $4 }')
    else
        brightness=$(external-brightness status 2>/dev/null | awk 'match($0, /[0-9]+%/) { print substr($0, RSTART, RLENGTH - 1); exit }')
    fi
    printf '%s\n' "${brightness:-unavailable}"

    jq -r '
        ([.[] | select(.focused == true)][0].name // ""),
        ([.[] | select(.focused == true)][0].scale // ""),
        ([.[] | {name, enabled:(.disabled != true), focused:(.focused == true), width, height}] | tojson)
    ' <<<"$json"
}

set_brightness() {
    local output=$1 percent=$2
    valid_output "$output" && [[ $percent =~ ^[0-9]+$ ]] || exit 2
    (( percent < 1 )) && percent=1
    (( percent > 100 )) && percent=100
    if [[ $output =~ ^(eDP|LVDS|DSI)- ]]; then
        bri "$percent" >/dev/null
    else
        external-brightness set "$percent" >/dev/null
    fi
}

set_scale() {
    local output=$1 scale=$2 json mode width height refresh x y
    valid_output "$output" && [[ $scale =~ ^[0-9]+([.][0-9]+)?$ ]] || exit 2
    json=$(monitors_json)
    mode=$(jq -r --arg output "$output" '.[] | select(.name == $output and .disabled != true) | [.width, .height, .refreshRate, .x, .y] | @tsv' <<<"$json")
    [[ -n $mode ]] || exit 1
    IFS=$'\t' read -r width height refresh x y <<<"$mode"
    "$hyprctl_bin" -q eval "hl.monitor({ output = \"$output\", mode = \"${width}x${height}@${refresh}\", position = \"${x}x${y}\", scale = $scale })"
}

set_enabled() {
    local output=$1 state=$2 active
    valid_output "$output" || exit 2
    case "$state" in
        on) monitor_enable "$output" ;;
        off)
            active=$(monitors_json | jq '[.[] | select(.disabled != true)] | length')
            (( active > 1 )) || { echo "Refusing to disable the final active display" >&2; exit 1; }
            monitor_disable "$output"
            ;;
        *) exit 2 ;;
    esac
}

case "${1:-toggle}" in
    status)
        status
        ;;
    panel-state)
        panel_state
        ;;
    set-brightness)
        set_brightness "${2:-}" "${3:-}"
        ;;
    set-scale)
        set_scale "${2:-}" "${3:-}"
        ;;
    set-enabled)
        set_enabled "${2:-}" "${3:-}"
        ;;
    toggle)
        connected=$(active_secondary)
        available=$(available_secondary)

        if [ -n "$connected" ]; then
            monitor_disable "$connected"
            echo "Disabled $connected"
        elif [ -n "$available" ]; then
            monitor_enable "$available"
            echo "Connected $available to the right of $primary"
        else
            echo "No secondary monitor detected"
        fi
        ;;
    *)
        echo "use: monitor [toggle|status|panel-state|set-brightness OUTPUT N|set-scale OUTPUT SCALE|set-enabled OUTPUT on|off]" >&2
        exit 2
        ;;
esac
