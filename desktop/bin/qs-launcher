#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.nix-profile/bin:$HOME/bin:$HOME/.local/bin:$PATH"
qs_bin="${QS_BIN:-$HOME/.nix-profile/bin/qs}"
quickshell_bin="${QUICKSHELL_BIN:-$HOME/.nix-profile/bin/quickshell}"
config_path="${QUICKSHELL_PATH:-$HOME/.config/quickshell/marcelof/shell.qml}"
log_file="${QS_LAUNCHER_LOG:-/tmp/qs-launcher.log}"
export QS_CONFIG_PATH="$config_path"
export QT_QUICK_BACKEND="${QT_QUICK_BACKEND:-software}"

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Launcher" "$1"
    else
        printf "%s\n" "$1" >&2
    fi
}

launcher_action="${1:-open}"

open_quickshell() {
    local output

    if output=$("$qs_bin" ipc --path "$config_path" --any-display call launcher "$launcher_action" 2>&1); then
        if grep -Fq "Not ready to accept queries yet." <<<"$output"; then
            printf "%s\n" "$output" >>"$log_file"
            return 1
        fi
        [ -z "$output" ] || printf "%s\n" "$output" >>"$log_file"
        return 0
    fi

    printf "%s\n" "$output" >>"$log_file"
    return 1
}

start_quickshell() {
    "$quickshell_bin" --path "$config_path" --no-duplicate --daemonize >>"$log_file" 2>&1 || true
}

restart_quickshell() {
    qs-bar restart >>"$log_file" 2>&1 || true
}

: >"$log_file"
if open_quickshell; then
    exit 0
fi

start_quickshell
sleep 0.5
if open_quickshell; then
    exit 0
fi

restart_quickshell
sleep 0.8
if open_quickshell; then
    exit 0
fi

notify "Quickshell launcher is not available. See $log_file."
exit 1
