#!/usr/bin/env bash
set -euo pipefail

run_qs() {
  command -v qs-bar >/dev/null 2>&1 && qs-bar "$@" >/dev/null 2>&1 || true
}

case "${1:-}" in
  volume-up) pactl set-sink-volume @DEFAULT_SINK@ +10%; run_qs osd-volume ;;
  volume-down) pactl set-sink-volume @DEFAULT_SINK@ -10%; run_qs osd-volume ;;
  volume-fine-up) pactl set-sink-volume @DEFAULT_SINK@ +1%; run_qs osd-volume ;;
  volume-fine-down) pactl set-sink-volume @DEFAULT_SINK@ -1%; run_qs osd-volume ;;
  mute) pactl set-sink-mute @DEFAULT_SINK@ toggle; run_qs osd-volume ;;
  mic-mute) pactl set-source-mute @DEFAULT_SOURCE@ toggle; run_qs osd-mic ;;
  brightness-up) /home/marcelof/bin/bri +10; run_qs osd-brightness ;;
  brightness-down) /home/marcelof/bin/bri -10; run_qs osd-brightness ;;
  brightness-fine-up) /home/marcelof/bin/bri +1; run_qs osd-brightness ;;
  brightness-fine-down) /home/marcelof/bin/bri -1; run_qs osd-brightness ;;
  brightness-max) brightnessctl set 100%; run_qs osd-brightness ;;
  brightness-min) brightnessctl set 1%; run_qs osd-brightness ;;
  kbd-up) brightnessctl -d 'dell::kbd_backlight' set +1; run_qs osd-kbd ;;
  kbd-down) brightnessctl -d 'dell::kbd_backlight' set 1-; run_qs osd-kbd ;;
  self-test)
    for cmd in pactl brightnessctl /home/marcelof/bin/bri; do command -v "$cmd" >/dev/null 2>&1 || true; done
    printf 'desktop-osd self-test: ok\n'
    ;;
  *) printf 'use: desktop-osd [volume-up|volume-down|volume-fine-up|volume-fine-down|mute|mic-mute|brightness-up|brightness-down|brightness-fine-up|brightness-fine-down|brightness-max|brightness-min|kbd-up|kbd-down|self-test]\n' >&2; exit 2 ;;
esac
