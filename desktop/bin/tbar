#!/usr/bin/env bash

################################################################################
#                                 FILE INFO
# Compatibility adapter for Board status surfaces.
################################################################################

set -Eeuo pipefail

FORMAT="${TBAR_FORMAT:-tmux}"
case "${1:-}" in
  --format)
    [[ $# -ge 2 ]] || {
      echo "tbar: --format requires tmux, herdr, or plain" >&2
      exit 2
    }
    FORMAT="$2"
    shift 2
    ;;
  --format=*)
    FORMAT="${1#*=}"
    shift
    ;;
esac

case "$FORMAT" in
  tmux) BOARD_FORMAT=tmux ;;
  herdr) BOARD_FORMAT=terminal ;;
  plain) BOARD_FORMAT=plain ;;
  *)
    echo "tbar: unsupported format: $FORMAT" >&2
    exit 2
    ;;
esac

SURFACE="${TBAR_SURFACE:-tmux-top}"
BOARD_ARGS=(render --format "$BOARD_FORMAT" --surface "$SURFACE")
if [[ "$FORMAT" == "herdr" ]]; then
  BOARD_ARGS+=(--color never)
fi
exec board "${BOARD_ARGS[@]}" "$@"
