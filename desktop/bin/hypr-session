#!/usr/bin/env bash

set -euo pipefail

desktop_nix_bin="${NIX_DESKTOP_BIN:-$HOME/.local/share/dotfiles-nix/desktop/bin}"
export PATH="$desktop_nix_bin:$HOME/bin:$HOME/.local/bin:$PATH"
export XDG_DATA_DIRS="${NIX_DESKTOP_SHARE:-$HOME/.local/share/dotfiles-nix/desktop/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

config="${HYPR_CONFIG:-$HOME/.config/hypr/init.lua}"
shell_config="${QUICKSHELL_CONFIG:-marcelof}"
profile="${HYPR_PROFILE:-default}"
start_shell() {
    if command -v qbar >/dev/null 2>&1; then
        qbar start
        return
    fi
    QT_QUICK_BACKEND="${QT_QUICK_BACKEND:-software}" "$desktop_nix_bin/quickshell" --path "$HOME/.config/quickshell/marcelof/shell.qml" --no-duplicate --daemonize
}

need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'missing: %s\n' "$1" >&2
        return 1
    fi
}

service_state() {
    local scope="$1" unit="$2" state
    if [ "$scope" = "user" ]; then
        state=$(systemctl --user is-active "$unit" 2>/dev/null || true)
    else
        state=$(systemctl is-active "$unit" 2>/dev/null || true)
    fi
    printf '%s\n' "${state:-unknown}"
}

quickshell_status() {
    local instances

    need qs || return 1
    instances=$(qs list --all 2>/dev/null || true)
    if printf '%s\n' "$instances" | grep -q '^Instance '; then
        printf 'quickshell: active\n'
        return 0
    fi

    printf 'quickshell: inactive\n' >&2
    return 1
}

time_sync_status() {
    local props timezone synced ntp chrony timesyncd

    need timedatectl || return 1
    props=$(timedatectl show -p Timezone -p NTPSynchronized -p NTP 2>/dev/null || true)
    timezone=$(printf '%s\n' "$props" | awk -F= '$1 == "Timezone" {print $2}')
    synced=$(printf '%s\n' "$props" | awk -F= '$1 == "NTPSynchronized" {print $2}')
    ntp=$(printf '%s\n' "$props" | awk -F= '$1 == "NTP" {print $2}')

    printf 'time: synced=%s ntp=%s timezone=%s\n' "${synced:-unknown}" "${ntp:-unknown}" "${timezone:-unknown}"
    if command -v systemctl >/dev/null 2>&1; then
        chrony=$(service_state system chrony.service)
        timesyncd=$(service_state system systemd-timesyncd.service)
        printf 'time-service: chrony=%s systemd-timesyncd=%s\n' "$chrony" "$timesyncd"
    fi

    [[ "$synced" = "yes" && "$ntp" = "yes" ]]
}

audio_status() {
    if command -v audioctl >/dev/null 2>&1; then
        audioctl status | sed 's/^/audio: /'
    fi
}

notification_owner_status() {
    if ! command -v gdbus >/dev/null 2>&1; then
        printf "notifications: unchecked missing gdbus\n"
        return 0
    fi

    local owner pid args
    owner=$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus --method org.freedesktop.DBus.GetNameOwner org.freedesktop.Notifications 2>/dev/null | grep -o ":[0-9.]*" || true)
    if [ -z "$owner" ]; then
        printf "notifications: missing owner\n" >&2
        return 1
    fi

    pid=$(gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus --method org.freedesktop.DBus.GetConnectionUnixProcessID "$owner" 2>/dev/null | grep -o "[0-9][0-9]*" | tail -n 1 || true)
    args=$(ps -p "$pid" -o args= 2>/dev/null || true)
    printf "notifications: owner=%s pid=%s cmd=%s\n" "$owner" "${pid:-unknown}" "${args%% *}"
    case "$args" in
        *quickshell*) return 0 ;;
        *) return 1 ;;
    esac
}

dunst_status() {
    if command -v systemctl >/dev/null 2>&1; then
        local state enabled
        state=$(service_state user dunst.service)
        enabled=$(systemctl --user is-enabled dunst.service 2>/dev/null || true)
        printf "dunst: %s enabled=%s\n" "$state" "${enabled:-unknown}"
        [ "$state" != "active" ]
    fi
}

legacy_launcher_status() {
    local missing=0
    local app_dir="${XDG_DATA_HOME:-$HOME/.local/share}/applications"
    local entries=(
        compton.desktop
        feh.desktop
        i3.desktop
        kazam.desktop
        nitrogen.desktop
        org.freedesktop.Xwayland.desktop
        rofi-theme-selector.desktop
        rofi.desktop
        x11vnc.desktop
        xtigervncviewer.desktop
    )

    for entry in "${entries[@]}"; do
        if ! grep -Eq '^Hidden=true$' "$app_dir/$entry" 2>/dev/null; then
            printf 'legacy-launcher-mask: missing %s\n' "$entry" >&2
            missing=1
        fi
    done

    if [ "$missing" -eq 0 ]; then
        printf 'legacy-launcher-mask: ok\n'
    fi
    return "$missing"
}

config_status() {
    local missing=0
    local hypr_dir="${HYPR_CONFIG_DIR:-$HOME/.config/hypr}"
    local quickshell_file="${QUICKSHELL_FILE:-$HOME/.config/quickshell/$shell_config/shell.qml}"

    if command -v luac >/dev/null 2>&1; then
        if luac -p "$hypr_dir/init.lua" "$hypr_dir/profiles/default.lua" "$hypr_dir/profiles/omarchy.lua"; then
            printf "hypr-lua: ok\n"
        else
            missing=1
        fi
    else
        printf "hypr-lua: unchecked missing luac\n"
    fi

    if command -v qmllint >/dev/null 2>&1; then
        if qmllint "$quickshell_file" >/dev/null; then
            printf "quickshell-qml: ok\n"
        else
            missing=1
        fi
    else
        printf "quickshell-qml: unchecked missing qmllint\n"
    fi

    if command -v Hyprland >/dev/null 2>&1; then
        if Hyprland --config "$config" --verify-config >/dev/null; then
            printf "hypr-verify: ok\n"
        else
            missing=1
        fi
    else
        printf "hypr-verify: unchecked missing Hyprland\n"
    fi

    return "$missing"
}

keybinding_status() {
    local missing=0 output
    local hypr_dir="${HYPR_CONFIG_DIR:-$HOME/.config/hypr}"
    local tab
    tab=$(printf "\t")

    need hypr-keys || return 1
    for name in default omarchy; do
        output=$(HYPR_KEYS_PROFILE_DIR="$hypr_dir/profiles" hypr-keys "$name" 2>/dev/null || true)
        if printf "%s\n" "$output" | grep -Fq "Profile${tab}${name}" &&
            printf "%s\n" "$output" | grep -Fq "Win+/${tab}Keybindings" &&
            printf "%s\n" "$output" | grep -Fq "Win+D${tab}Apps" &&
            printf "%s\n" "$output" | grep -Fq "Win+M${tab}Start/stop saved audio" &&
            printf "%s\n" "$output" | grep -Fq "XF86MonBrightnessUp${tab}Screen brightness"; then
            printf "hypr-keys-%s: ok\n" "$name"
        else
            printf "hypr-keys-%s: broken\n" "$name" >&2
            missing=1
        fi
    done

    return "$missing"
}

quickshell_ipc_status() {
    local missing=0
    local quickshell_dir="${QUICKSHELL_DIR:-$HOME/.config/quickshell/$shell_config}"
    local needles=(
        "target: \"bar\""
        "function controls()"
        "function media()"
        "function screen()"
        "function wallpaper()"
        "function calendar()"
        "function personalDashboard()"
        "function notifications()"
        "function power()"
        "function keybindings()"
        "function closePanels()"
        "function settings()"
        "function dnd()"
        "function osdVolume()"
        "function osdBrightness()"
        "function osdKbd()"
        "function osdMic()"
        "target: \"launcher\""
        "target: \"passmenu\""
        "target: \"websearch\""
        "target: \"network\""
        "target: \"lock\""
    )

    for needle in "${needles[@]}"; do
        if ! grep -R -Fq --include="*.qml" "$needle" "$quickshell_dir" 2>/dev/null; then
            printf "quickshell-ipc: missing %s\n" "$needle" >&2
            missing=1
        fi
    done

    if [ "$missing" -eq 0 ]; then
        printf "quickshell-ipc: ok\n"
    fi
    return "$missing"
}

quickshell_bar_status() {
    local missing=0 qbar_file
    qbar_file=$(command -v qbar 2>/dev/null || true)
    if [ -z "$qbar_file" ]; then
        printf "quickshell-bar: missing qbar\n" >&2
        return 1
    fi

    local needles=(
        "menu_toggle() { ipc_target shell toggle"
        "menu_summon() { ipc_target shell summon"
        "launcher) menu_summon launcher"
        "controls) menu_toggle controls"
        "notifications) menu_toggle notifications"
        "network) ipc_target omarchy.network toggle"
        "clipboard) menu_toggle omarchy.clipboard"
        "close-panels) ipc_target shell closePanels"
        "osd-volume) ipc osdVolume"
        "websearch) ipc_target websearch toggle"
    )

    for needle in "${needles[@]}"; do
        if ! grep -Fq "$needle" "$qbar_file" 2>/dev/null; then
            printf "quickshell-bar: missing %s\n" "$needle" >&2
            missing=1
        fi
    done

    if [ "$missing" -eq 0 ]; then
        printf "quickshell-bar: ok\n"
    fi
    return "$missing"
}

status() {
    local missing=0
    local required_bins=(
        start-hyprland
        hyprctl
        quickshell
        board
        hypr-term
        qbar
        grim
        slurp
        swappy
        tesseract
        wf-recorder
        brightnessctl
        pactl
        wpctl
        dex
        jq
        notify-send
        nmcli
        wl-copy
        wl-paste
        playerctl
        pavucontrol
        xdg-open
        loginctl
        xdph
        xdph-install-system
    )

    for bin in "${required_bins[@]}"; do
        need "$bin" || missing=1
    done

    quickshell_status || missing=1
    notification_owner_status || missing=1
    dunst_status || missing=1
    legacy_launcher_status || missing=1
    config_status || missing=1
    keybinding_status || missing=1
    quickshell_ipc_status || missing=1
    quickshell_bar_status || missing=1
    time_sync_status || missing=1
    audio_status || true

    if [ ! -e /etc/NIXOS ] && command -v start-hyprland >/dev/null 2>&1; then
        need nixGL || missing=1
    fi

    if command -v hyprlock >/dev/null 2>&1; then
        printf 'locker: hyprlock\n'
    elif command -v swaylock >/dev/null 2>&1; then
        printf 'locker: swaylock\n'
    elif command -v loginctl >/dev/null 2>&1; then
        printf 'locker: loginctl fallback\n'
    else
        printf 'missing: hyprlock, swaylock, or loginctl\n' >&2
        missing=1
    fi

    if ! command -v hyprpicker >/dev/null 2>&1; then
        printf 'optional missing: hyprpicker\n' >&2
    fi

    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        printf 'session: hyprland\n'
        if command -v systemctl >/dev/null 2>&1; then
            local portal_hyprland portal bluetooth
            portal_hyprland=$(service_state user xdg-desktop-portal-hyprland.service)
            portal=$(service_state user xdg-desktop-portal.service)
            printf 'portal-hyprland: %s\n' "$portal_hyprland"
            printf 'portal: %s\n' "$portal"
            [[ "$portal_hyprland" = "active" && "$portal" = "active" ]] || missing=1
            if command -v bluetoothctl >/dev/null 2>&1; then
                bluetooth=$(service_state system bluetooth.service)
                printf 'bluetooth: %s\n' "$bluetooth"
            fi
        fi
        hyprctl version || true
    elif [ -n "${DISPLAY:-}" ]; then
        printf 'session: x11 or xwayland display=%s\n' "$DISPLAY"
    else
        printf 'session: none detected\n'
    fi

    return "$missing"
}

test_session() {
    local rc=0
    status || rc=$?
    printf 'config: %s\n' "$config"
    printf 'quickshell: %s\n' "$shell_config"
    printf 'hypr_profile: %s\n' "$profile"
    return "$rc"
}

start_session() {
    status || true
    printf 'config: %s\n' "$config"
    printf 'quickshell: %s\n' "$shell_config"
    printf 'hypr_profile: %s\n' "$profile"

    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        reload_session
        return 0
    fi

    exec start-hyprland --force-nixgl -- --config "$config"
}

reload_session() {
    need hyprctl
    hyprctl reload
    if command -v qbar >/dev/null 2>&1; then
        qbar restart
    elif command -v quickshell >/dev/null 2>&1; then
        pkill quickshell 2>/dev/null || true
        start_shell
    fi
}

rollback() {
    if [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        hyprctl dispatch exit
    else
        printf 'Not inside Hyprland. X11 configs are archived under archive/x11/desktop.\n'
    fi
}

case "${1:-status}" in
    status|smoke) status ;;
    test) test_session ;;
    start) start_session ;;
    reload) reload_session ;;
    rollback|exit) rollback ;;
    *)
        printf 'usage: %s [status|smoke|test|start|reload|rollback]\n' "${0##*/}" >&2
        exit 2
        ;;
esac
