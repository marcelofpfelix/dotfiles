#!/usr/bin/env bash

set -euo pipefail

notice() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Clipboard history" "$1"
    else
        printf 'Clipboard history: %s\n' "$1" >&2
    fi
}

need() {
    if ! command -v "$1" >/dev/null 2>&1; then
        notice "Install $1 to enable clipboard history."
        exit 1
    fi
}

status() {
    local missing=0 cmd count history
    history="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/clipboard-history.json"
    for cmd in jq wl-copy qbar fzf notify-send; do
        if command -v "$cmd" >/dev/null 2>&1; then
            printf 'ok   %s\n' "$cmd"
        else
            printf 'missing %s\n' "$cmd" >&2
            missing=1
        fi
    done
    count="$(jq 'length' "$history" 2>/dev/null || printf 0)"
    printf 'entries %s\n' "${count:-0}"
    printf 'owner omarchy.clipboard\n'
    return "$missing"
}

case "${1:-menu}" in
    status)
        status
        ;;
    watch)
        notice "Clipboard watchers are owned by omarchy.clipboard."
        exit 2
        ;;
    menu)
        need jq
        need wl-copy
        if [[ -z "${CLIPHIST_FORCE_TERMINAL:-}" && -n "${WAYLAND_DISPLAY:-}" ]] && command -v qbar >/dev/null 2>&1; then
            exec qbar clipboard
        fi

        history="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/clipboard-history.json"
        [[ -r "$history" ]] || entries=""
        entries="${entries:-$(jq -r 'to_entries[] | "\(.key)\t" + (if .value.type == "image" then "[image] \(.value.path)" else (.value.text | gsub("[\\r\\n\\t]+"; " ") | .[0:200]) end)' "$history" 2>/dev/null)}"
        if [[ -z "$entries" ]]; then
            notice "No clipboard history yet."
            exit 0
        fi

        if command -v fzf >/dev/null 2>&1; then
            selection=$(printf '%s\n' "$entries" | fzf) || exit 0
        else
            notice "Install fzf to select clipboard history outside Wayland."
            exit 1
        fi

        [[ -n "$selection" ]] || exit 0
        index=${selection%%$'\t'*}
        type=$(jq -r --argjson index "$index" '.[$index].type' "$history")
        if [[ "$type" == image ]]; then
            mime=$(jq -r --argjson index "$index" '.[$index].mime' "$history")
            path=$(jq -r --argjson index "$index" '.[$index].path' "$history")
            omarchy-clipboard-paste-file --copy-only "$mime" "$path"
        else
            omarchy-clipboard-paste-text --copy-only --history-index "$index"
        fi
        ;;
    *)
        printf 'usage: %s [menu|watch|status]\n' "${0##*/}" >&2
        exit 2
        ;;
esac
