#!/usr/bin/env bash
set -euo pipefail

src="$HOME/.local/share/xdg-desktop-portal/portals/hyprland.portal"
dst="/usr/share/xdg-desktop-portal/portals/hyprland.portal"

if [ ! -f "$src" ]; then
    printf 'missing: %s\n' "$src" >&2
    exit 1
fi

sudo cp "$src" "$dst"
systemctl --user daemon-reload
systemctl --user restart xdg-desktop-portal-hyprland.service xdg-desktop-portal.service xdg-desktop-portal-gtk.service
