#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.nix-profile/bin:$HOME/bin:$HOME/.local/bin:/nix/var/nix/profiles/default/bin:$PATH"
choose_site=0
if [[ ${1:-} == --choose-site ]]; then
  choose_site=1
  shift
fi

. "${HOME}/lib/lib_picker.sh"

site="google"
if [[ "${1:-}" == "status" || "${1:-}" == "--status" ]]; then
  picker_status
  rc=$?
  if command -v websearch >/dev/null 2>&1; then
    printf 'ok   websearch\n'
  else
    printf 'missing websearch\n' >&2
    rc=1
  fi
  exit "$rc"
fi

while getopts ":s:h" opt; do
  case "$opt" in
    s) site="$OPTARG" ;;
    h) printf "usage: %s [--choose-site] [-s site] [query]\n" "${0##*/}"; exit 0 ;;
    *) exit 2 ;;
  esac
done
shift $((OPTIND - 1))

if (( choose_site )); then
  selection=$(printf '%s\n' $'󰊭\tGoogle\tgoogle' $'󰗃\tYouTube\tyoutube' $'󰊤\tGitHub\tgithub' $'󰌃\tJira\tjira' $'󰧮\tGuru\tguru' $'󰘂\tCall lookup\tcall' | picker_choose "Search site") || exit 0
  site=${selection##*$'\t'}
fi

if [[ $# -gt 0 ]]; then
  exec websearch -s "$site" "$*"
fi

query=$(PICKER_BACKEND="${PICKER_BACKEND:-walker}" picker_input "Search") || exit 0
[[ -n "$query" ]] || exit 0
exec websearch -s "$site" "$query"
