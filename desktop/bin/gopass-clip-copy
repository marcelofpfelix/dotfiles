#!/bin/sh

# Gopass clipboard copy helper.
# Receives the entry name as $1 and the secret on stdin.
# Hides the secret from clipboard manager history.
#
# Controlled by CLIP_BACKEND env var (gpaste or copyq).

BACKEND="${CLIP_BACKEND:-gpaste}"

case "$BACKEND" in
    gpaste)
        # gpaste-client add-password requires the secret in argv. Keep stdin-only
        # handling here and pause GPaste tracking so the secret is not saved there.
        gpaste-client stop 2>/dev/null || true
        gpaste-client
        gpaste-client start 2>/dev/null || true
        ;;
    copyq)
        echo "gopass-clip-copy: copyq backend cannot safely copy secrets without argv" >&2
        exit 1
        ;;
    *)
        echo "gopass-clip-copy: unknown CLIP_BACKEND: $BACKEND" >&2
        exit 1
        ;;
esac
