#!/usr/bin/env bash

set -euo pipefail

workspace() {
    if [ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
        echo "Error: gowork requires Hyprland." >&2
        exit 1
    fi
    hyprctl dispatch workspace "$1"
}

workspace_with_layout() {
    workspace "$1"
}

workspace 4
wezterm start -- tmux new -s dash &
sleep 1

workspace 5
slack &
sleep 1

workspace_with_layout 3
chrome-wayland --profile-directory="Default" &
zed ~/work.code-workspace &
# chrome-wayland --profile-directory="Default"  --app-id=kjgfgldnnfoeklkmfkjfagphfepbbdan &
