#!/usr/bin/env bash

# passmenu - menu interface to gopass
#
# Modes:
#   (default)    Copy password to clipboard
#   --type       Type password via xdotool/ydotool
#   --user       Type the "username" field via xdotool/ydotool
#   --name       Type the entry name via xdotool/ydotool
#
# Environment:
#   PASSMENU_BACKEND   Password manager command (default: gopass)
#   PASSMENU_USER_KEY  Key name for username field (default: username)
#
# Usage:
#   passmenu [--type|--user|--name]

set -euo pipefail

backend="${PASSMENU_BACKEND:-gopass}"
user_key="${PASSMENU_USER_KEY:-username}"

mode="copy"
case "${1:-}" in
	--type) mode="type-pass"; shift ;;
	--user) mode="type-user"; shift ;;
	--name) mode="type-name"; shift ;;
esac

open_quickshell() {
	local qs_bin="${QS_BIN:-$HOME/.local/share/dotfiles-nix/desktop/bin/qs}"
	local quickshell_bin="${QUICKSHELL_BIN:-$HOME/.local/share/dotfiles-nix/desktop/bin/quickshell}"
	local config_path="${QUICKSHELL_PATH:-$HOME/.config/quickshell/marcelof/shell.qml}"
	local log_file="${QBAR_LOG:-/tmp/qbar.log}"

	"$qs_bin" ipc --path "$config_path" --any-display call passmenu open "$mode" "$user_key" "$backend" >>"$log_file" 2>&1 && return 0
	"$quickshell_bin" --path "$config_path" --no-duplicate --daemonize >>"$log_file" 2>&1 || true
	sleep 0.5
	"$qs_bin" ipc --path "$config_path" --any-display call passmenu open "$mode" "$user_key" "$backend" >>"$log_file" 2>&1
}

if [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
	echo "Error: passmenu is Quickshell-only in the Wayland desktop profile." >&2
	exit 1
fi

open_quickshell
