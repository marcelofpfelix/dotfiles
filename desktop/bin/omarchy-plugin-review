#!/usr/bin/env bash
set -euo pipefail

usage() {
  printf "use: omarchy-plugin-review [--first-party] <plugin-dir|manifest.json>\n" >&2
}

first_party=0
if [[ ${1:-} == "--first-party" ]]; then
  first_party=1
  shift
fi

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  self-test|--self-test) ;;
  "") usage; exit 2 ;;
esac

need_jq() {
  command -v jq >/dev/null 2>&1 || { printf "omarchy-plugin-review: missing jq\n" >&2; exit 1; }
}

review() {
  local input=$1 dir manifest rc id name version kinds entries
  rc=0

  if [ -d "$input" ]; then
    dir=$input
    manifest=$dir/manifest.json
  else
    manifest=$input
    dir=$(dirname -- "$manifest")
  fi

  [ -r "$manifest" ] || { printf "fail manifest missing %s\n" "$manifest" >&2; return 1; }
  jq -e . "$manifest" >/dev/null || { printf "fail manifest invalid-json %s\n" "$manifest" >&2; return 1; }

  if find "$dir" -type l -print -quit | grep -q .; then
    printf "fail symlink-found %s\n" "$dir" >&2
    rc=1
  fi

  jq -e ".schemaVersion == 1" "$manifest" >/dev/null || { printf "fail schemaVersion must be 1\n" >&2; rc=1; }
  jq -e "(.id|type==\"string\" and test(\"^[a-z0-9][a-z0-9.-]*[a-z0-9]$\"))" "$manifest" >/dev/null || { printf "fail id invalid\n" >&2; rc=1; }
  jq -e "(.name|type==\"string\" and length > 0) and (.version|type==\"string\" and length > 0)" "$manifest" >/dev/null || { printf "fail name/version required\n" >&2; rc=1; }
  jq -e "(.kinds|type==\"array\" and length > 0 and all(.[]; IN(\"bar-widget\",\"panel\",\"overlay\",\"menu\",\"service\",\"bar\")))" "$manifest" >/dev/null || { printf "fail kinds invalid\n" >&2; rc=1; }
  jq -e "(.entryPoints|type==\"object\")" "$manifest" >/dev/null || { printf "fail entryPoints required\n" >&2; rc=1; }
  jq -e "def key_for_kind: if . == \"bar-widget\" then \"barWidget\" else . end; . as \$m | all(\$m.kinds[]; (. as \$kind | (\$m.entryPoints[\$kind|key_for_kind] // \"\") | type == \"string\" and length > 0))" "$manifest" >/dev/null || { printf "fail entryPoints missing for claimed kind\n" >&2; rc=1; }

  jq -r ".entryPoints[]?" "$manifest" | while IFS= read -r entry; do
    case "$entry" in
      ""|/*|../*|*/../*) printf "fail unsafe-entryPoint %s\n" "$entry" >&2; exit 1 ;;
    esac
    [ -f "$dir/$entry" ] || { printf "fail missing-entryPoint %s\n" "$entry" >&2; exit 1; }
  done || rc=1

  id=$(jq -r ".id" "$manifest")
  if [[ $first_party -eq 0 && $id == omarchy.* ]]; then
    printf "fail reserved-id %s\n" "$id" >&2
    rc=1
  fi

  name=$(jq -r ".name" "$manifest")
  version=$(jq -r ".version" "$manifest")
  kinds=$(jq -r ".kinds | join(\",\")" "$manifest")
  entries=$(jq -r ".entryPoints | to_entries | map(.key + \"=\" + .value) | join(\",\")" "$manifest")

  if (( rc == 0 )); then
    printf "ok   %s %s %s\n" "$id" "$version" "$name"
    printf "kinds %s\n" "$kinds"
    printf "entryPoints %s\n" "$entries"
    printf "note plugins are unsandboxed QML; review code before enabling\n"
  fi
  return "$rc"
}

self_test() {
  local tmp
  tmp=$(mktemp -d)
  mkdir -p "$tmp/good" "$tmp/bad"
  printf "import QtQuick\nItem {}\n" >"$tmp/good/Menu.qml"
  printf "%s\n" "{\"schemaVersion\":1,\"id\":\"local.menu\",\"name\":\"Local Menu\",\"version\":\"1.0.0\",\"kinds\":[\"menu\"],\"entryPoints\":{\"menu\":\"Menu.qml\"}}" >"$tmp/good/manifest.json"
  printf "%s\n" "{\"schemaVersion\":1,\"id\":\"omarchy.bad\",\"name\":\"Bad\",\"version\":\"1.0.0\",\"kinds\":[\"menu\"],\"entryPoints\":{\"menu\":\"../Bad.qml\"}}" >"$tmp/bad/manifest.json"
  "$0" "$tmp/good" >/dev/null
  if "$0" "$tmp/bad" >/dev/null 2>&1; then
    printf "omarchy-plugin-review self-test: failed\n" >&2
    rm -rf "$tmp"
    exit 1
  fi
  rm -rf "$tmp"
  printf "omarchy-plugin-review self-test: ok\n"
}

need_jq
case "${1:-}" in
  self-test|--self-test) self_test ;;
  *) review "$1" ;;
esac
