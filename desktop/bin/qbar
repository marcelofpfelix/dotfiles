#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.nix-profile/bin:$HOME/bin:$HOME/.local/bin:$PATH"
export QT_QUICK_BACKEND="${QT_QUICK_BACKEND:-software}"

QUIET=0
if [[ ${1:-} == "-q" ]]; then
  QUIET=1
  shift
fi

qs_bin="${QS_BIN:-$HOME/.nix-profile/bin/qs}"
quickshell_bin="${QUICKSHELL_BIN:-$HOME/.nix-profile/bin/quickshell}"
config_path="${QUICKSHELL_PATH:-$HOME/.config/quickshell/marcelof/shell.qml}"
log_file="${QBAR_LOG:-/tmp/qbar.log}"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_lib="${script_dir%/bin}/lib/lib_qs_menus.sh"
if [ -r "$repo_lib" ]; then
  . "$repo_lib"
else
  . "${LIBS_DIR:-$HOME/lib}/lib_qs_menus.sh"
fi

quickshell_pids() {
  ps -eo pid=,args= | awk -v bin="$quickshell_bin" -v cfg="$config_path" '$2 == bin && index($0, "--path " cfg) { print $1 }'
}

list_instances() {
  ps -eo pid=,args= | awk -v bin="$quickshell_bin" -v cfg="$config_path" '$2 == bin && index($0, "--path " cfg) { pid=$1; $1=""; sub(/^ +/, ""); printf "Process %s:%s\n", pid, $0 }'
}

usage() {
  printf 'use: qbar [-q] [start|stop|restart|reload|status|runtime-prune|shell|notice|toggle|show|hide|root-menu|tray|controls|calendar|work-inbox|personal-dashboard|notifications|display|battery|bluetooth|wifi-qr|power|session-action|inhibit|keybindings|clipboard|emoji|clipboard-update|passmenu|websearch|media|screen|wallpaper|launcher|settings|dnd|osd-volume|osd-brightness|osd-kbd|osd-mic|close-panels]\n' >&2
}

kill_all() {
  local pids

  pids=$(quickshell_pids || true)
  [ -n "$pids" ] || return 0
  kill $pids 2>/dev/null || true
}

runtime_prune() {
  local force root path found
  force=0
  [ "${1:-}" = "--force" ] && force=1
  root="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/quickshell/by-path"
  [ -d "$root" ] || return 0
  found=0
  for path in "$root"/*; do
    [ -L "$path" ] || continue
    [ ! -e "$path" ] || continue
    found=1
    if [ "$force" -eq 1 ]; then
      unlink -- "$path"
      printf "removed %s\n" "$path"
    else
      printf "would-remove %s\n" "$path"
    fi
  done
  [ "$found" -eq 1 ] || printf "no stale quickshell by-path entries\n"
}

recover_wayland_display() {
  [ -n "${WAYLAND_DISPLAY:-}" ] && return 0
  local runtime socket
  runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  for socket in "$runtime"/wayland-[0-9]*; do
    [ -S "$socket" ] || continue
    export WAYLAND_DISPLAY="${socket##*/}"
    return 0
  done
}

call_ipc() {
  local output status target
  target=$1
  shift

  recover_wayland_display
  if output=$(timeout --kill-after=1s "${QBAR_IPC_TIMEOUT:-2s}" "$qs_bin" ipc --path "$config_path" --any-display call "$target" "$@" 2>&1); then
    status=0
  else
    status=$?
  fi

  if (( status != 0 )); then
    (( QUIET )) && return 0
    printf "%s\n" "$output" >&2
    return 1
  fi

  case "$output" in
    "Not ready to accept queries yet"*)
      printf "%s\n" "$output" >>"$log_file"
      (( QUIET )) && return 0
      return 1
      ;;
    "Target not found."*|"Function not found."*|"Too few arguments provided"*|"Too many arguments provided"*)
      (( QUIET )) && return 0
      printf "%s\n" "$output" >&2
      return 1
      ;;
  esac

  [ -z "$output" ] || printf "%s\n" "$output"
  return 0
}

restart_quickshell() {
  kill_all
  sleep 0.3
  start
  for _ in {1..30}; do
    call_ipc shell ping >/dev/null 2>&1 && return 0
    sleep 0.1
  done
  return 1
}

ipc() {
  call_ipc bar "$1"
}

ipc_target() {
  local target=$1
  shift
  call_ipc "$target" "$@"
}

menu_toggle() { ipc_target shell toggle "$1" "{}"; }
menu_summon() { ipc_target shell summon "$1" "{}"; }

keybindings_menu() {
  "$HOME/bin/hypr-keys" --omarchy |
    "$HOME/bin/omarchy-menu-select" Keybindings -- --width 800 --height 500 >/dev/null || true
}

notice() {
  command -v notify-send >/dev/null 2>&1 || return 0
  case "${1:-}" in
    time)
      notify-send -a desktop-notice -u low "󰥔 Time" "$(check-time-panel 2>/dev/null || date)"
      ;;
    weather)
      notify-send -a desktop-notice -u low "󰖕 Weather" "$(check-weather 2>/dev/null || printf 'Weather unavailable')"
      ;;
    battery)
      local battery summary
      battery=$(upower -e 2>/dev/null | grep -m1 BAT || true)
      if [ -n "$battery" ]; then
        summary=$(upower -i "$battery" 2>/dev/null | awk -F: '/state|percentage|capacity/ { gsub(/^ +/, "", $2); print $1 ": " $2 }')
      fi
      notify-send -a desktop-notice -u low "󰁹 Battery" "${summary:-Battery unavailable}"
      ;;
    *)
      printf 'use: qbar notice [time|weather|battery]\n' >&2
      exit 2
      ;;
  esac
}

running() {
  [ -n "$(quickshell_pids || true)" ]
}

start() {
  running && return 0
  "$quickshell_bin" --path "$config_path" --no-duplicate --daemonize >>"$log_file" 2>&1 || true
  sleep 0.3
  running && return 0
  "$quickshell_bin" --path "$config_path" --daemonize >>"$log_file" 2>&1 || true
  sleep 0.3
  running
}

case "${1:-status}" in
  start) start ;;
  stop) kill_all ;;
  restart|reload) restart_quickshell ;;
  status) list_instances ;;
  runtime-prune|prune-runtime) runtime_prune "${2:-}" ;;
  list-menus|menus) qs_menu_list ;;
  shell)
    shift
    [ $# -gt 0 ] || { usage; exit 2; }
    if [[ ${1:-} =~ ^(toggle|summon)$ && $# -eq 2 ]]; then
      set -- "$1" "$2" "{}"
    fi
    call_ipc shell "$@"
    ;;
  notice) shift; notice "${1:-}" ;;
  toggle|show|hide) ipc "$1" ;;
  launcher) menu_summon launcher ;;
  root-menu|menu) menu_toggle root-menu ;;
  tray|tray-manage) menu_toggle tray ;;
  controls) menu_toggle controls ;;
  media|audio) ipc_target omarchy.audio toggle ;;
  screen|screenshot|record) menu_toggle screen ;;
  wallpaper) ipc_target bar wallpaper ;;
  calendar) menu_toggle calendar ;;
  work-inbox|work|inbox) menu_toggle work-inbox ;;
  personal-dashboard|dashboard|personal) menu_toggle personal-dashboard ;;
  settings) menu_toggle settings ;;
  dnd) menu_toggle dnd ;;
  osd-volume) ipc osdVolume ;;
  osd-brightness) ipc osdBrightness ;;
  osd-kbd) ipc osdKbd ;;
  osd-mic) ipc osdMic ;;
  notifications) menu_toggle notifications ;;
  display|monitor) ipc_target omarchy.monitor toggle ;;
  battery) ipc_target omarchy.power toggle ;;
  bluetooth) ipc_target omarchy.bluetooth toggle ;;
  wifi-qr|wifiqr) menu_toggle wifiqr ;;
  network) ipc_target omarchy.network toggle ;;
  websearch) ipc_target websearch toggle ;;
  lock) ipc_target lock lock ;;
  power|session) menu_toggle power ;;
  session-action)
    [ -n "${2:-}" ] || { usage; exit 2; }
    ipc_target session request "$2"
    ;;
  power-confirm) ipc_target session confirmReboot ;;
  inhibit|stay-awake) menu_toggle inhibit ;;
  keybindings|keys) keybindings_menu ;;
  clipboard) menu_toggle clipboard ;;
  emoji|emojis) menu_toggle emojis ;;
  clipboard-update) ipc clipboardUpdate ;;
  passmenu) ipc_target passmenu open copy username gopass ;;
  close-panels) ipc_target shell closePanels ;;
  *) usage; exit 2 ;;
esac
