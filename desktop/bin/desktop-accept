#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:$PATH"
repo=${DOTFILES_REPO:-$HOME/gwt/marcelofpfelix/dotfiles/main}

cd "$repo"

bash -n desktop/bin/qs-launcher desktop/bin/qs-bar desktop/bin/qs-menu-smoke desktop/bin/desktop-doctor desktop/bin/desktop-startup-report desktop/bin/passmenu-action desktop/bin/notification-focus-app desktop/bin/work-inbox-status desktop/bin/pomodoroctl desktop/bin/calendar-agenda-status desktop/bin/calendar-sync-status
luac -p desktop/.config/hypr/init.lua desktop/.config/hypr/profiles/default.lua desktop/.config/hypr/profiles/omarchy.lua
qmllint desktop/.config/quickshell/marcelof/shell.qml
home -y
qs-bar reload
hypr-session smoke
# shellcheck disable=SC2086
qs-menu-smoke ${DESKTOP_ACCEPT_PANELS:-}
desktop-doctor
