#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:$PATH"
repo=${DOTFILES_REPO:-$HOME/gwt/marcelofpfelix/dotfiles/main}
panels=${DESKTOP_ACCEPT_PANELS:-"launcher launcher-script controls media notifications calendar wallpaper screen settings keybindings clipboard websearch network tray power"}

cd "$repo"

bash -n desktop/bin/qs-launcher desktop/bin/qs-bar desktop/bin/qs-menu-smoke desktop/bin/desktop-doctor desktop/bin/desktop-startup-report
luac -p desktop/.config/hypr/init.lua desktop/.config/hypr/profiles/default.lua desktop/.config/hypr/profiles/omarchy.lua
qmllint desktop/.config/quickshell/marcelof/shell.qml
home -y
qs-bar reload
hypr-session smoke
# shellcheck disable=SC2086
qs-menu-smoke $panels
desktop-doctor
