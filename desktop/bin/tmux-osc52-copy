#!/usr/bin/env bash

set -euo pipefail

buf=$(cat)
printf '%s' "$buf" | tmux load-buffer - 2>/dev/null || true
encoded=$(printf '%s' "$buf" | base64 | tr -d '\n')
if [[ -n "${TMUX_PANE:-}" ]]; then
  tty=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_tty}' 2>/dev/null || true)
else
  tty=$(tty 2>/dev/null || true)
fi

if [[ -n "$tty" && -w "$tty" ]]; then
  printf '\033]52;c;%s\a' "$encoded" >"$tty"
else
  printf '\033]52;c;%s\a' "$encoded"
fi
