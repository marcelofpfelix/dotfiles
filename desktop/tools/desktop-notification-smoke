#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/bin:$HOME/.local/bin:$HOME/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:$PATH"

owner() {
  command -v gdbus >/dev/null 2>&1 || return 0
  gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus --method org.freedesktop.DBus.GetNameOwner org.freedesktop.Notifications >/dev/null
}

capabilities() {
  command -v gdbus >/dev/null 2>&1 || return 0
  gdbus call --session --dest org.freedesktop.Notifications --object-path /org/freedesktop/Notifications --method org.freedesktop.Notifications.GetCapabilities
}

actions_supported() {
  capabilities | grep -q actions
}

send_action_notification() {
  local log="${XDG_RUNTIME_DIR:-/tmp}/desktop-notification-smoke.action"
  notify-send -a desktop-notification-smoke -A open=Open -A done=Done -t 10000 "Desktop notification action smoke" "Open notifications; this card should show Open and Done buttons." >"$log" 2>/dev/null &
  qs-bar notifications >/dev/null 2>&1 || true
  printf "action-log %s\n" "$log"
}

send_routing_notifications() {
  local log="${XDG_RUNTIME_DIR:-/tmp}/desktop-notification-smoke.routing"
  : >"$log"
  notify-send -a desktop-neutral-smoke "Desktop neutral smoke" "This should be stored in history without a popup toast." >>"$log" 2>&1 || true
  notify-send -a desktop-critical-smoke -u critical "Desktop critical smoke" "This should still show a popup toast." >>"$log" 2>&1 || true
  qs-bar notifications >/dev/null 2>&1 || true
  printf "routing-log %s\n" "$log"
}

case "${1:-run}" in
  --status|status)
    command -v notify-send >/dev/null 2>&1
    command -v qs-bar >/dev/null 2>&1
    owner
    actions_supported
    ;;
  -h|--help)
    printf "use: desktop-notification-smoke [--status|actions|routing]\n"
    ;;
  run|actions)
    owner
    actions_supported
    send_action_notification
    ;;
  routing)
    owner
    actions_supported
    send_routing_notifications
    ;;
  *)
    printf "use: desktop-notification-smoke [--status|actions|routing]\n" >&2
    exit 2
    ;;
esac
