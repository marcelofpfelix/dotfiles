#!/usr/bin/env bash
set -euo pipefail

tool_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$tool_dir:$HOME/bin:$HOME/.local/bin:$HOME/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:$PATH"
repo=${DOTFILES_REPO:-$HOME/gwt/marcelofpfelix/dotfiles/main}

cd "$repo"

bash -n desktop/bin/qbar desktop/bin/omarchy-shell desktop/bin/omarchy-plugin-review desktop/bin/omarchy-plugin-add desktop/tools/qs-menu-smoke desktop/tools/desktop-doctor desktop/bin/desktop-startup-report desktop/bin/passmenu-action desktop/bin/notification-focus-app desktop/bin/notificationctl desktop/bin/reminderctl desktop/bin/work-inbox-status desktop/bin/pomodoroctl desktop/bin/calendar-agenda-status desktop/bin/calendar-sync-status
ruby -c desktop/tools/quickshell-repeat-audit
desktop/bin/omarchy-plugin-review desktop/tools/fixtures/plugin-overlay >/dev/null
luac -p desktop/.config/hypr/init.lua desktop/.config/hypr/profiles/common.lua desktop/.config/hypr/profiles/default.lua desktop/.config/hypr/profiles/omarchy.lua
qmllint desktop/.config/quickshell/marcelof/shell.qml
desktop/tools/quickshell-repeat-audit
home -y
qbar reload
hypr-session smoke
# shellcheck disable=SC2086
qs-menu-smoke ${DESKTOP_ACCEPT_PANELS:-}
desktop-doctor
