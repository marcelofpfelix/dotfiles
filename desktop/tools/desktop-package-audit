#!/usr/bin/env bash
set -uo pipefail

dotfiles_root="${DOTFILES_ROOT:-$HOME/gwt/marcelofpfelix/dotfiles/main}"
package_file="${HOMELAB_DESKTOP_PACKAGES:-$dotfiles_root/homelab/vars/config.yml}"
status=0

required_packages=(
  hyprland
  quickshell
  brave
  ghostty
  slack
  onepassword
  google_chrome
  wireshark
  network_manager
  pavucontrol
  swappy
  fzf
  gum
  htop
  jq
  taskwarrior
  timewarrior
  oath_toolkit
  sngrep
  tcpdump
  bluez
  brightnessctl
  ddcutil
  dex
  ffmpeg
  grim
  imagemagick
  libnotify
  lm_sensors
  mpv
  playerctl
  power_profiles_daemon
  pulseaudio_utils
  slurp
  tesseract
  upower
  wf_recorder
  wireplumber
  wl_clipboard
  xdg_utils
)

has_package() {
  grep -Eq "^[[:space:]]*-[[:space:]]*$1([[:space:]#]|$)" "$package_file" 2>/dev/null
}

if [ ! -r "$package_file" ]; then
  printf 'fail package-intent missing %s\n' "$package_file" >&2
  exit 1
fi

printf 'file %s\n' "$package_file"
for package in "${required_packages[@]}"; do
  if has_package "$package"; then
    printf 'ok   %s\n' "$package"
  else
    printf 'miss %s\n' "$package" >&2
    status=1
  fi
done

exit "$status"
