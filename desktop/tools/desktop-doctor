run_required desktop-privacy-status-self-test desktop-privacy-status self-test
run_required external-brightness-self-test external-brightness self-test

section "work inbox"
run_required work-inbox-status-self-test work-inbox-status --self-test
run_required work-inbox-status-no-network work-inbox-status --no-network

section "pomodoro"
run_required pomodoroctl-self-test pomodoroctl self-test
run_required pomodoroctl-status pomodoroctl status

section "calendar agenda"
run_required calendar-agenda-status-self-test calendar-agenda-status self-test
run_required calendar-sync-status-self-test calendar-sync-status self-test
run_required calendar-sync-status calendar-sync-status status

section "omarchy compatibility"
run_required omarchy-shell-self-test omarchy-shell self-test
run_required omarchy-menu-plugin-self-test omarchy-menu-plugin self-test
run_required omarchy-plugin-review-self-test omarchy-plugin-review self-test
run_required omarchy-plugin-add-self-test omarchy-plugin-add self-test

