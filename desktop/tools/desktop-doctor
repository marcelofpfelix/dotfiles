#!/usr/bin/env bash
set -uo pipefail

tool_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PATH="$tool_dir:$HOME/bin:$HOME/.local/bin:$HOME/.nix-profile/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/snap/bin:$PATH"

status=0
FIXABLE=false

case "${1:-}" in
  --fixable) FIXABLE=true; shift ;;
  -h|--help) printf 'use: desktop-doctor [--fixable]
'; exit 0 ;;
esac

if [ "$#" -gt 0 ]; then
  printf 'use: desktop-doctor [--fixable]
' >&2
  exit 2
fi

section() {
  printf '
%s
' "$1"
}

ok() {
  printf 'ok   %-22s %s
' "$1" "$2"
}

warn() {
  printf 'warn %-22s %s
' "$1" "$2"
}

fix_hint() {
  local command=${3:-}
  if [ -n "$command" ]; then
    printf 'fix  %-22s %s
' "$1" "$command"
    return
  fi

  case "$1" in
    hypr-session|hypr-keys|hypr-term|xdph|qbar|omarchy-shell|omarchy-plugin-review|omarchy-plugin-add|qs-menu-smoke|desktop-reload|desktop-notification-smoke|desktop-inhibit|desktop-accept|desktop-startup-report|audioctl|check-audio-streams|cliphist-menu|passmenu-action|screenshot-wayland|wallpaper-wayland|screen-record-wayland|monitor|chrome-wayland|brave-wayland|desktop-package-audit|check-wayland-no-x11|board|script-picker|walker-websearch|slack-wayland|discord-wayland|obsidian-wayland|1password-wayland|desktop-privacy-status|desktop-osd|external-brightness|media-now-playing|notification-focus-app|notificationctl|reminderctl|work-inbox-status|pomodoroctl|calendar-agenda-status|calendar-sync-status)
      printf 'fix  %-22s home -y
' "$1"
      ;;
    walker|gum|fzf|identify|compare|montage)
      printf 'fix  %-22s track/install the missing package in homelab, then run home -y
' "$1"
      ;;
    current-profile)
      printf 'fix  %-22s hypr-session reload
' "$1"
      ;;
    quickshell)
      printf 'fix  %-22s hypr-session reload
' "$1"
      ;;
    wayland-display|current-desktop|hyprctl-monitors)
      printf 'fix  %-22s log into the Hyprland Wayland session
' "$1"
      ;;
    xdg-desktop-portal-hyprland.service|xdg-desktop-portal.service)
      printf 'fix  %-22s systemctl --user restart xdg-desktop-portal-hyprland.service xdg-desktop-portal.service xdg-desktop-portal-gtk.service
' "$1"
      ;;
    hyprland-portal)
      printf 'fix  %-22s home -y && sudo /home/marcelof/bin/xdph-install-system
' "$1"
      ;;
    portal-xdg-data)
      printf 'fix  %-22s systemctl --user daemon-reload && systemctl --user restart xdg-desktop-portal.service
' "$1"
      ;;
  esac
}

fail() {
  printf 'fail %-22s %s
' "$1" "$2"
  status=1
  if [ "$FIXABLE" = true ]; then
    fix_hint "$1" "$2" "${3:-}"
  fi
}

check_cmd() {
  local name=$1 required=${2:-yes} path
  path=$(command -v "$name" 2>/dev/null || true)
  if [ -n "$path" ]; then
    ok "$name" "$path"
  elif [ "$required" = yes ]; then
    fail "$name" missing
  else
    warn "$name" missing
  fi
}

run_required() {
  local label=$1 command
  shift
  command=$1
  if ! command -v "$command" >/dev/null 2>&1; then
    fail "$label" "missing command: $command" "$*"
    return 1
  fi
  if "$@"; then
    return 0
  fi
  fail "$label" "command failed: $*" "$*"
}

check_absent_process() {
  local label=$1 pattern=$2 matches
  matches=$(pgrep -af "$pattern" 2>/dev/null || true)
  if [ -z "$matches" ]; then
    ok "$label" absent
    return 0
  fi
  fail "$label" "running: $(printf %s "$matches" | sed -n '1p')" "pkill -f $pattern"
}

current_profile() {
  local line tab
  tab=$(printf '\t')
  line=$(hypr-keys 2>/dev/null | sed -n '1p' || true)
  case "$line" in
    Profile"$tab"*) ok current-profile "${line#*"$tab"}" ;;
    *) fail current-profile "hypr-keys did not report profile" ;;
  esac
}

check_wayland_wrapper_common() {
  local wrapper=$1 path=$2 require_gpu=${3:-true} flag var

  for var in __EGL_VENDOR_LIBRARY_FILENAMES LD_LIBRARY_PATH LIBGL_DRIVERS_PATH LIBVA_DRIVERS_PATH GBM_BACKENDS_PATH VDPAU_DRIVER_PATH VK_ICD_FILENAMES VK_LAYER_PATH __GLX_VENDOR_LIBRARY_NAME QT_QUICK_BACKEND; do
    if grep -Fq -- "unset $var" "$path" 2>/dev/null; then
      ok "$wrapper" "unsets $var"
    else
      fail "$wrapper" "missing unset $var"
    fi
  done

  for flag in '--ozone-platform=wayland'; do
    if grep -Fq -- "$flag" "$path" 2>/dev/null; then
      ok "$wrapper" "$flag"
    else
      fail "$wrapper" "missing $flag"
    fi
  done

  if [ "$require_gpu" = true ]; then
    if grep -Fq -- 'WebRTCPipeWireCapturer' "$path" 2>/dev/null; then
      ok "$wrapper" WebRTCPipeWireCapturer
    else
      fail "$wrapper" "missing WebRTCPipeWireCapturer"
    fi
    if grep -Eq -- '--use-gl=egl|--use-angle=opengl|--use-gl=angle|--in-process-gpu|--disable-gpu' "$path" 2>/dev/null; then
      fail "$wrapper" "contains GL flags known to break WebGL here"
    else
      ok "$wrapper" "no broken GL override flags"
    fi
  elif grep -Fq -- '--disable-gpu' "$path" 2>/dev/null; then
    ok "$wrapper" "GPU disabled for compatibility"
  else
    fail "$wrapper" "missing --disable-gpu compatibility flag"
  fi
}

check_browser_wrapper() {
  local name=$1 wrapper=$2 browser=$3 path browser_path flag
  path=$(command -v "$wrapper" 2>/dev/null || true)
  if [ -z "$path" ]; then
    fail "$wrapper" missing
    return
  fi
  ok "$wrapper" "$path"

  browser_path=$(command -v "$browser" 2>/dev/null || true)
  if [ -n "$browser_path" ]; then
    ok "$name-bin" "$browser_path"
  else
    warn "$name-bin" "missing $browser"
  fi

  check_wayland_wrapper_common "$wrapper" "$path"

  for flag in '--enable-native-notifications' '--disable-vulkan'; do
    if grep -Fq -- "$flag" "$path" 2>/dev/null; then
      ok "$wrapper" "$flag"
    else
      fail "$wrapper" "missing $flag"
    fi
  done
}

check_electron_wrapper() {
  local name=$1 wrapper=$2 app=$3 require_gpu=${4:-true} path app_path
  path=$(command -v "$wrapper" 2>/dev/null || true)
  if [ -z "$path" ]; then
    fail "$wrapper" missing
    return
  fi
  ok "$wrapper" "$path"

  app_path=$(command -v "$app" 2>/dev/null || true)
  if [ -n "$app_path" ]; then
    ok "$name-bin" "$app_path"
  else
    warn "$name-bin" "missing $app"
  fi

  check_wayland_wrapper_common "$wrapper" "$path" "$require_gpu"
}

check_user_service_active() {
  local service=$1 state
  state=$(systemctl --user is-active "$service" 2>/dev/null || true)
  if [ "$state" = active ]; then
    ok "$service" active
  else
    fail "$service" "${state:-missing}"
  fi
}

check_screen_share() {
  local portal_file portal_env wrapper path

  if [ -n "${WAYLAND_DISPLAY:-}" ]; then
    ok wayland-display "$WAYLAND_DISPLAY"
  else
    fail wayland-display missing
  fi

  if [ "${XDG_CURRENT_DESKTOP:-}" = Hyprland ]; then
    ok current-desktop Hyprland
  else
    fail current-desktop "${XDG_CURRENT_DESKTOP:-missing}"
  fi

  if hyprctl monitors -j >/dev/null 2>&1; then
    ok hyprctl-monitors ok
  else
    fail hyprctl-monitors failed
  fi

  check_user_service_active xdg-desktop-portal-hyprland.service
  check_user_service_active xdg-desktop-portal.service

  portal_file="$HOME/.local/share/xdg-desktop-portal/portals/hyprland.portal"
  if [ -r "$portal_file" ] && grep -Fq ScreenCast "$portal_file"; then
    ok hyprland-portal ScreenCast
  else
    fail hyprland-portal "missing ScreenCast in $portal_file"
  fi

  portal_env=$(systemctl --user show xdg-desktop-portal.service -p Environment --value 2>/dev/null || true)
  case "$portal_env" in
    *"$HOME/.local/share"*) ok portal-xdg-data "$HOME/.local/share" ;;
    *) fail portal-xdg-data "missing $HOME/.local/share" ;;
  esac

  path=$(command -v xdph 2>/dev/null || true)
  if [ -z "$path" ]; then
    fail xdph missing
  elif grep -Fq "exec nixGL" "$path" 2>/dev/null; then
    fail xdph "wraps portal with nixGL"
  elif grep -Fq "hypr-clean-env" "$path" 2>/dev/null; then
    ok xdph hypr-clean-env
  else
    fail xdph "missing hypr-clean-env"
  fi

  for wrapper in chrome-wayland brave-wayland; do
    path=$(command -v "$wrapper" 2>/dev/null || true)
    if [ -n "$path" ] && grep -Fq WebRTCPipeWireCapturer "$path"; then
      ok "$wrapper" WebRTCPipeWireCapturer
    else
      fail "$wrapper" "missing WebRTCPipeWireCapturer"
    fi
  done
}

check_qs_menu_smoke_latest() {
  local base latest summary contact failed max_age now mtime age qml_file qml_mtime panel
  local panels=()

  base="${QS_MENU_SMOKE_BASE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/quickshell/menu-smoke}"
  latest="${QS_MENU_SMOKE_LATEST:-$base/latest}"
  summary="$latest/summary.tsv"
  contact="$latest/contact.png"
  max_age="${QS_MENU_SMOKE_MAX_AGE_SECONDS:-86400}"

  if [ ! -r "$summary" ]; then
    warn qs-menu-smoke-latest "not run yet"
    return
  fi

  mtime=$(stat -c %Y "$summary" 2>/dev/null || printf 0)
  if [ "$max_age" -gt 0 ] 2>/dev/null; then
    now=$(date +%s)
    age=$((now - mtime))
    if [ "$age" -gt "$max_age" ]; then
      fail qs-menu-smoke-latest "stale ${age}s" "qs-menu-smoke"
      return
    fi
  fi

  qml_file="${QUICKSHELL_FILE:-$HOME/.config/quickshell/marcelof/shell.qml}"
  qml_mtime=$(stat -c %Y "$qml_file" 2>/dev/null || printf 0)
  if [ "$qml_mtime" -gt "$mtime" ]; then
    fail qs-menu-smoke-latest "older than $qml_file" "qs-menu-smoke"
    return
  fi

  mapfile -t panels < <(qs-menu-smoke --list)
  for panel in "${panels[@]}"; do
    if ! awk -F "\t" -v panel="$panel" '$1 == panel && $2 == "ok" { found=1 } END { exit !found }' "$summary"; then
      fail qs-menu-smoke-latest "missing $panel panel" "qs-menu-smoke $panel"
      return
    fi
  done

  if [ ! -s "$contact" ]; then
    fail qs-menu-smoke-latest "missing contact sheet" "qs-menu-smoke"
    return
  fi

  failed=$(awk -F "\t" 'NR > 1 && $2 != "ok" { count++ } END { print count + 0 }' "$summary")
  if [ "$failed" -gt 0 ]; then
    fail qs-menu-smoke-latest "$failed failed panel(s)" "qs-menu-smoke"
  else
    ok qs-menu-smoke-latest "$summary"
  fi
}

check_board_status() {
  local config="${BOARD_CONFIG:-$HOME/.config/board/board.toml}" watch_count
  if [ -r "$config" ]; then
    ok board-config "$config"
  else
    fail board-config "missing $config" "home -y"
    return
  fi

  if board --config "$config" render --format quickshell --surface quickshell-bar >/dev/null 2>&1; then
    ok board-render quickshell-bar
  else
    fail board-render "quickshell-bar failed" "board --config $config render --format quickshell --surface quickshell-bar"
  fi

  if pgrep -fx "$HOME/bin/board run" >/dev/null 2>&1; then
    ok board-run scheduler
  else
    fail board-run stopped "$HOME/bin/board run"
  fi

  watch_count=$(pgrep -fc "^board --config $config render --watch --format quickshell --surface quickshell-bar$")
  if [ "$watch_count" -eq 1 ]; then
    ok board-watch "one plugin-owned stream"
  else
    fail board-watch "$watch_count streams"
  fi

  if [ -r "$HOME/.config/omarchy/plugins/marcelof.board-status/manifest.json" ] \
      && [ -r "$HOME/.config/omarchy/plugins/marcelof.board-dashboard/manifest.json" ] \
      && ! grep -Fq 'ShellPersonalDashboardPanel' "$HOME/.config/quickshell/marcelof/shell.qml"; then
    ok board-plugins "status and dashboard own shell surfaces"
  else
    fail board-plugins "missing plugin or embedded dashboard remains" "home -y && qbar restart"
  fi

  if grep -Fq 'anchors.centerIn: parent' "$HOME/.config/omarchy/plugins/marcelof.board-status/BarWidget.qml" \
      && grep -Fq 'textFormat: Text.RichText' "$HOME/.config/omarchy/plugins/marcelof.board-status/BarWidget.qml"; then
    ok board-widget "centered rich text"
  else
    fail board-widget "alignment or rich text regressed"
  fi
}

check_audio_status() {
  local output
  if ! output=$(audioctl status 2>&1); then
    fail audioctl "status failed"
    printf '%s
' "$output"
    return
  fi

  ok audioctl status
  if printf '%s
' "$output" | grep -q '^icon: '; then
    ok audioctl-icon present
  else
    fail audioctl-icon missing
  fi

  if printf '%s
' "$output" | grep -q '^helper: running'; then
    if printf '%s
' "$output" | grep -q '^display: '; then
      ok audioctl-display present
    else
      fail audioctl-display "helper running without display"
    fi
  else
    ok audioctl-display "not required while stopped"
  fi
}

check_notification_smoke_status() {
  if desktop-notification-smoke --status; then
    ok notification-smoke ready
  else
    fail notification-smoke "not ready" "desktop-notification-smoke --status"
  fi
}

check_shell_layout_contract() {
  local root="$HOME/.config/quickshell/marcelof"
  local menu missing=()

  if grep -Fq 'localPluginWatcher' "$root/services/PluginRegistry.qml" \
      && grep -Fq 'BarWidgetRegistry { id: barWidgetRegistry }' "$root/shell.qml"; then
    ok plugin-foundation "full registry and shared widget registry"
  else
    fail plugin-foundation "reduced registry remains"
  fi

  if grep -Fq 'visible: status !== Loader.Ready || (item && item.visible)' "$root/ShellBar.qml" \
      && grep -Fq 'spacing: barTheme.spacingSm' "$root/ShellBar.qml"; then
    ok bar-plugin-spacing "hidden widgets collapse in compact group"
  else
    fail bar-plugin-spacing "dynamic widgets can reserve empty spacing"
  fi

  if grep -Fq 'barVisible: batteryPresent && !batteryFull' "$root/plugins/panels/power/Panel.qml" \
      && grep -Fq 'visible: barVisible' "$root/plugins/panels/power/Panel.qml"; then
    ok battery-full-hidden "fully charged battery collapses"
  else
    fail battery-full-hidden "full battery remains in bar"
  fi

  if grep -Fq 'root.signalStrength + "%"' "$root/plugins/panels/network/Panel.qml" \
      && grep -Fq 'row.net.signal + "%"' "$root/plugins/panels/network/Panel.qml"; then
    ok wifi-signal-percent "connected and scanned networks"
  else
    fail wifi-signal-percent "numeric signal strength hidden"
  fi

  if grep -Eq '^  "learn("|\.)' "$root/omarchy-menu.jsonc"; then
    fail root-menu-learn "Learn category remains"
  else
    ok root-menu-learn absent
  fi

  if grep -Fq 'omarchy-menu-select" Keybindings' "$HOME/bin/qbar"; then
    ok keybindings-menu "Omarchy selector"
  else
    fail keybindings-menu "custom panel route remains"
  fi

  while read -r menu; do
    case "$menu" in
      root-menu|power-confirm) continue ;;
      launcher) grep -Fq '"provider":"apps"' "$root/omarchy-menu.jsonc" || missing+=("$menu") ;;
      controls) grep -Fq '"status":' "$root/omarchy-menu.jsonc" || missing+=("$menu") ;;
      media-controls) jq -e '.menu.id == "trigger.media"' "$HOME/.config/omarchy/plugins/marcelof.media-controls/manifest.json" >/dev/null || missing+=("$menu") ;;
      network-tools) jq -e '.menu.id == "status.network-tools"' "$HOME/.config/omarchy/plugins/marcelof.network-tools/manifest.json" >/dev/null || missing+=("$menu") ;;
      personal-dashboard) jq -e '.menu.id == "status.dashboard"' "$HOME/.config/omarchy/plugins/marcelof.board-dashboard/manifest.json" >/dev/null || missing+=("$menu") ;;
      *) grep -Fq "\$HOME/bin/qbar $menu" "$root/omarchy-menu.jsonc" || missing+=("$menu") ;;
    esac
  done < <(qbar list-menus)
  if ((${#missing[@]} == 0)); then
    ok root-menu-coverage "all public menus reachable"
  else
    fail root-menu-coverage "missing: ${missing[*]}"
  fi
}

section "required commands"
for cmd in hypr-session hypr-keys hypr-term qbar omarchy-shell omarchy-menu-select omarchy-menu-plugin omarchy-plugin-validate omarchy-plugin-review omarchy-plugin-list omarchy-plugin-add omarchy-plugin-enable omarchy-plugin-disable omarchy-plugin-remove qs-menu-smoke desktop-reload desktop-notification-smoke desktop-inhibit board identify compare montage audioctl check-audio-streams cliphist-menu passmenu-action screenshot-wayland wallpaper-wayland screen-record-wayland monitor desktop-accept desktop-startup-report chrome-wayland brave-wayland desktop-package-audit check-wayland-no-x11 script-picker walker-websearch desktop-privacy-status desktop-osd external-brightness media-now-playing notification-focus-app notificationctl reminderctl work-inbox-status pomodoroctl calendar-agenda-status calendar-sync-status; do
  check_cmd "$cmd" yes
done
check_cmd walker yes
check_cmd gum yes
check_cmd fzf yes

section "pickers"
