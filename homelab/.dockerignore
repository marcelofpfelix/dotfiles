# Allowlist pattern: ignore everything, then include only what the image needs.
*

# Python dependency metadata
!pyproject.toml
!uv.lock

# Ansible core files
!ansible.cfg
!inventory.ini
!collections/
!collections/requirements.yml
collections/ansible_collections/

# Ansible playbooks and configuration
!*.yml
!vars/
!vars/**
!files/
!files/**
!playbooks/
!playbooks/**
group_vars/
host_vars/
templates/
vars/work/

# Runtime entrypoint
!ci/
ci/*
!ci/entrypoint.sh
