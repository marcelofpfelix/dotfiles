#!/usr/bin/env bash

################################################################################
#                                 FILE INFO
# bar to show in polybar
################################################################################

export BAR_COLOR_FORMAT="${BAR_COLOR_FORMAT:-polybar}"
[[ "$BAR_COLOR_FORMAT" == "polybar" || "$BAR_COLOR_FORMAT" == "lemonbar" ]] && export LEMONBAR=1

# scripts to run (collected into a single space-separated line)
SCRIPTS=(check-gpg check-docker check-temp)
#SCRIPTS+=(alerts check-time check-resolv check-safe)

OUTPUTS=()
for script in "${SCRIPTS[@]}"; do
  out=$("$script" 2>&1 | tr -d '\n')
  [[ -n "$out" ]] && OUTPUTS+=("$out")
done

echo "${OUTPUTS[*]}"
